procedure assassinate_frag begin
   call assassinate_dodge(DMG_explosion);
   remove_pid_qty(dude_obj, PID_FRAG_GRENADE, 1)
end

procedure assassinate_plasma begin
   call assassinate_dodge(DMG_plasma);
   remove_pid_qty(dude_obj, PID_PLASMA_GRENADE, 1)
end

