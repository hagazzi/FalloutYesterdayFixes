procedure assassinate_dodge(variable assassination_type) begin
   explosion(tile_num(Dodge_Ptr), elevation(Dodge_Ptr), 10);
   critter_dmg(Dodge_Ptr, random(150, 300), assassination_type);
   inc_good_critter
   set_global_var(GVAR_ENEMY_HOOVER_DAM, 1);
   set_global_var(GVAR_DODGE_ASSASSINATED, 1);
end

