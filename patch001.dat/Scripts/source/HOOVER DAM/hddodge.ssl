procedure Node077
begin

variable str, xp;
xp = 3000;
str = mstr(2480);

if (major_dead) then begin
   str = str + " " + mstr(2481);
   xp -= 1000;
end

if (ailis_dead) then begin
   str = str + " " + mstr(2483);
   xp -= 1000;
end
else
   str = str + " " + mstr(2482);

str = str + " " + mstr(2484);

set_global_var(GVAR_QUEST_ARREST_AILIS_PIP, QUEST_COMPLETED);

give_xp(xp);
display_mstr(151);
inc_hoover_dam_rep(20);

// We busted both Devon and Ailis
if (
   (global_var(GVAR_QUEST_FIND_POISONER) == 3) and
   (global_var(GVAR_QUEST_HOOVER_PEACE) == QUEST_ACCEPTED)
   ) then
   set_global_var(GVAR_QUEST_HOOVER_PEACE, QUEST_COMPLETED);

Reply(str);
NOption(2181,Node999,4);
end

