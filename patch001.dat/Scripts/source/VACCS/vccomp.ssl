procedure Smash begin
   variable r := random(0, 5);

   if (r == 0) then
      call Node004;
   else if (r == 1) then
      call Node005;
   else if (r == 2) then
      call Node006;
   else if (r == 3) then
      call Node002;
   else if (r == 4) then
      call Node008;
   else
      call Node007;
end

procedure use_skill_on_p_proc begin

   if (action_being_used == SKILL_REPAIR) then begin
       script_overrides;

      if(
          skill_success(source_obj, SKILL_REPAIR, -10) and
          local_var(LVAR_Broken) == 1
        ) then begin
         set_local_var(LVAR_Broken, 0);
         display_msg(mstr_skill(606) + " " + obj_name(self_obj) + ".");
         call repair_time;

      end else begin
         display_msg(mstr_skill(607) + " " + obj_name(self_obj) + ".");
         call repair_time;
      end

   end else if (action_being_used == SKILL_SCIENCE) then begin
      script_overrides;

      if(skill_success(source_obj, SKILL_SCIENCE, -25) and local_var(LVAR_Locked) == 1 and local_var(LVAR_Broken) == 0) then begin
         set_local_var(LVAR_Locked, 0);
         display_mstr(105);
      end else begin
         display_mstr(106);
      end

   end

end

procedure use_obj_on_p_proc begin
   variable tool := obj_pid(obj_being_used_with);

   if (
   tool == PID_WRENCH or
   tool == PID_MULTI_TOOL or
   tool == PID_SUPER_TOOL_KIT
   ) then begin
      script_overrides;

      if(
          skill_success(source_obj, SKILL_REPAIR, 10) and
          local_var(LVAR_Broken) == 1
        ) then begin
         set_local_var(LVAR_Broken, 0);
         display_msg(mstr_skill(606) + " " + obj_name(self_obj) + ".");
         call repair_time;

      end else begin
         display_msg(mstr_skill(607) + " " + obj_name(self_obj) + ".");
         call repair_time;
      end

   end
end

procedure repair_time begin
    fadeout(1);
    game_time_advance(ONE_GAME_HOUR);
    fadein(1);
end
