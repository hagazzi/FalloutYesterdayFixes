procedure mark_vault29() begin

   if(not(town_known(AreaNukeStatus(AREA_TWIN_MOTHERS)))) then begin
      give_xp(500);
      mark_on_map(AreaNukeStatus(AREA_TWIN_MOTHERS))
      display_msg(g_mstr(1008) + " " + mstr(107) + ".");
   end

   call Node017;

end


