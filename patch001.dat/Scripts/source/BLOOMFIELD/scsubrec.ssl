procedure Node_010
begin
Reply(500);
if(local_var(LVAR_DivertHabitAdmin) == 0) then
NOption(501,Node_011,1);
if(local_var(LVAR_DivertOpComm) == 0) then
NOption(502,Node_012,1);
if(local_var(LVAR_DivertRocketAss) == 0) then
NOption(503,Node_013,1);
if(
   (local_var(LVAR_DivertHabitAdmin) == 1) and
   (local_var(LVAR_DivertOpComm) == 1) and
   (local_var(LVAR_DivertRocketAss) == 1) and
   (global_var(GVAR_QUEST_15_RESTORE_OC_POWER) < 2)
   ) then
NOption(504,Node_014,1);
NOption(325,Node_020,1);
NOption(505,Node_004,1);
NOption(327,Node999,1);
end

procedure Node_011
begin
   set_local_var(LVAR_DivertHabitAdmin, 1);
Reply(530);
