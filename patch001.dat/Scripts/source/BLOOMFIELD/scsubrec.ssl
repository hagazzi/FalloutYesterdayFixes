end

procedure Node_013
begin
Reply(590);
set_local_var(LVAR_DivertRocketAss, 1);
NOption(291,Node_010,1);
NOption(505,Node_004,1);
end

procedure Node_014
begin

   if (
      (global_var(GVAR_QUEST_15_RESTORE_OC_POWER) < 2) and
      (local_var(LVAR_AuxOn) == 1) and
      (local_var(LVAR_PrimOn) == 1) and
      (local_var(LVAR_DivertHabitAdmin) == 1) and
      (local_var(LVAR_DivertOpComm) == 1) and
      (local_var(LVAR_DivertRocketAss) == 1)
      ) then begin
         set_global_var(GVAR_QUEST_15_RESTORE_OC_POWER, 2);
         give_xp(2000);
         display_mstr(150);
    end

Reply(620);
NOption(291,Node_010,1);
NOption(505,Node_004,1);
end

