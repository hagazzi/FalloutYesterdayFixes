// Node Node_001
//
// Notes:
//
// This is the opening node when the computer is in hibernation (all generators are off)

procedure Node_001
begin
Reply(230);
NOption(231,Node_002,1);
NOption(232,Node999,1);
end

procedure Node_002
begin
Reply(260);
NOption(261,Node_003,1);
NOption(262,Node999,1);
end

procedure Node_003
begin
   set_local_var(LVAR_AuxOn, 1);
Reply(290);
NOption(291,Node_004,1);
end

procedure Node_004
begin
Reply(320);
// NOTE: if PGs are offline
if (local_var(LVAR_PrimOn) == 0) then
NOption(321,Node_005,1);
// NOTE: if PGs are online
if (local_var(LVAR_PrimOn) == 1) then
NOption(322,Node_006,1);
// NOTE: if AGs are offline
if (local_var(LVAR_AuxOn) == 0) then
NOption(323,Node_003,1);
// NOTE: if AGs are online
if (local_var(LVAR_AuxOn) == 1) then
NOption(324,Node_007,1);
NOption(325,Node_020,1);
// NOTE: Only if primary generators are online.
if (local_var(LVAR_PrimOn) == 1) then
NOption(326,Node_010,1);
NOption(327,Node999,1);
end

