procedure UnlockDoor begin
   variable door;

   door := obj_blocking_tile(6307, self_elevation, BLOCKING_TYPE_BLOCK);

//   obj_unlock(door);                                    // engine unlock door
// TODO Workaround , obj_unlock didn't work
   destroy_object(door);
   create_object(33556598, 6307, self_elevation);
   set_local_var(LVAR_UnlockedDoor, 1);

   call Node999;

end

