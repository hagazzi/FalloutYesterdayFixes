/* Standard Script Procedures */
procedure start;
procedure map_enter_p_proc;
procedure map_update_p_proc;
procedure map_exit_p_proc;
procedure setup_endgame_slideshow;

/* Defines */
#define NAME                  SCRIPT_LANDING


/*****************************************************************
   Local Variables which are saved.
   All Local Variables need to be prepended by LVAR_
*****************************************************************/


/*******************************************************************
   Imported variables from the Map scripts. These should only be
   pointers and variables that need not be saved. If a variable
   Needs to be saved, make it a map variable (MVAR_)
*******************************************************************/


/*******************************************************************
   Local variables which do not need to be saved between map changes.
*******************************************************************/


/*******************************************************************
*                           PROCEDURES                             *
*******************************************************************/
procedure start begin
end

procedure map_enter_p_proc begin

   if not(is_loading_game) then begin
      if map_first_run then begin
         game_time_advance_hour(1200);
         Lighting;
         override_map_start_hex(21118, 0, 3);
         display_mstr(100);
         mark_on_map(AREA_LANDING_SITE)
         gfade_out(1);
         call setup_endgame_slideshow;
         endgame_slideshow;
//         endgame_movie;
      end else begin
         call Check_Create_Vehicle;

         fadein(1);
         Lighting;
      end
   end

end

procedure map_update_p_proc begin
   Lighting;
end

procedure map_exit_p_proc begin
   fadeout(1);
end

procedure setup_endgame_slideshow begin

   // Some rep stuff
   set_global_var(GVAR_LIVING_LEGEND, 1);
   set_global_var(GVAR_ASTRONAUT, 1);

   // just in case, we don't want to trigger special Tibbets CODE ending
   if (global_var(GVAR_CODE_STATUS) == 100) then begin
      set_global_var(GVAR_CODE_STATUS, 99);
   end

/*
      #####
      # Dog Town
      #####
      462, 1, 609, NAR_DT2
      463, 1, 610, NAR_DT3
      464, 1, 611, NAR_DT4
      465, 1, 612, NAR_DT5
      466, 1, 613, NAR_DT6
      467, 1, 614, NAR_DT7
      468, 1, 615, NAR_DT8
      */

      if (global_var(GVAR_BOMB001_M6_TARGET) == AREA_DOGTOWN) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_DT1, 1);
         remove_from_map(AREA_DOGTOWN)
         mark_on_map(AREA_DOGTOWN_NUKED)
      end

      /*
      #####
      # Boulder Dome
      #####
      414, 1, 441, NAR_BD2
      415, 1, 442, NAR_BD3
      416, 1, 443, NAR_BD4
      417, 1, 444, NAR_BD5
      418, 1, 445, NAR_BD6
      419, 1, 446, NAR_BD7
      420, 1, 447, NAR_BD8
      421, 1, 448, NAR_BD9
      422, 1, 449, NAR_BD10
*/

      if (global_var(GVAR_BOMB001_M6_TARGET) == AREA_BOULDER_DOME) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_BD1, 1);
         remove_from_map(AREA_BOULDER_DOME)
         mark_on_map(AREA_BOULDER_DOME_NUKED)
      end

/*
      #####
