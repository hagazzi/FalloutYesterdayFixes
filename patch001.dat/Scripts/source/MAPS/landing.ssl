      # Bloomfield
      #####
      428, 1, 459, NAR_BL1
      430, 1, 461, NAR_BL3
      431, 1, 462, NAR_BL4
*/
    if (global_var(GVAR_BOMB001_M1_TARGET) == AREA_BLOOMFIELD) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_BL2, 1);
      remove_from_map(AREA_BLOOMFIELD)
      mark_on_map(AREA_BLOOMFIELD_NUKED)
    end

/*
      #####
      # Grand Canyon
      #####
      469, 1, 616, NAR_GC1
      470, 1, 617, NAR_GC2
      541, 1, 684, NAR_PC2

      #####
      # Circle Junction
      #####

      458, 1, 605, NAR_CJ1
      459, 1, 606, NAR_CJ2
*/
    if (global_var(GVAR_BOMB001_M8_TARGET) == AREA_CIRCLE_JUNCTION) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_CJ3, 1);
      remove_from_map(AREA_CIRCLE_JUNCTION)
      mark_on_map(AREA_CIRCLE_JUNCTION_NUKED)
    end
/*


      #####
      # Subnode: ODYSSEUS
      #####
*/

// Always set
   set_global_var(GVAR_ENDGAME_MOVIE_ODY, 1);

/*
      #####
      # Subnode: ARGOS
      #####

*/

// Always set
// TODO Maybe make it optional if player destroys 100 units
set_global_var(GVAR_ENDGAME_MOVIE_ARGOS, 1);

/*

      #####
      # Subnode: Badger
      #####
      517, 1, 660, NAR_ABDGR

      #####
      # Subnode: Bear (Animal)
      #####
      518, 1, 661, NAR_ABEAR

      #####
      # Subnode: Alexandra
      #####

*/
         if (
            (global_var(GVAR_KNOW_ALEXANDRA) == 1) and
            (global_var(GVAR_ALEXANDRA_DEAD) != 1)
         ) then begin
            set_global_var(GVAR_ENDGAME_MOVIE_ALEX, 1);
         end

/*
      #####
      # Subnode: Alkaya
      #####
      520, 1, 663, NAR_ALKYA

      #####
      # Subnode: Lynx
      #####
      521, 1, 664, NAR_ALYNX

      #####
      # Subnode: Ashley
      #####
      522, 1, 665, NAR_ASHLY

      #####
      # Subnode: Wolf
      #####
      523, 1, 666, NAR_AWOLF

      #####
      # Subnode: BAJAR
      #####
      524, 1, 667, NAR_BAJAR

      #####
      # Subnode: Bear
      #####
      525, 1, 668, NAR_BEAR

      #####
      # Subnode: Beatrice
      #####
*/
   if (
      (global_var(GVAR_KNOW_BEATRICE) == 1) and
      (global_var(GVAR_BEATRICE_DEAD) != 1)
   ) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_BEATR, 1);
   end

/*
      #####
      # Subnode: Battery
      #####
      528, 1, 671, NAR_BTTRY

      #####
      # Subnode: Christine
      #####
      529, 1, 672, NAR_CHRIS

      #####
      # Subnode: CRB-S
      #####
      530, 1, 673, NAR_CRBS

      #####
      # Subnode: Devil Dog
      #####
      531, 1, 674, NAR_DDOG

      #####
      # Subnode: Hanged Man
      #####
*/

   if (
      Hanged_Man_In_Party and
      (global_var(GVAR_HANGED_MAN_LIVES) > 0)
   ) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_HMAN, 1);
   end

/*
      #####
      # Subnode: Jackhammer
      #####
      533, 1, 676, NAR_JACKH

      #####
      # Subnode: Job
      #####
      534, 1, 677, NAR_JOB

      #####
      # Subnode: Kurisu
      #####
      535, 1, 678, NAR_KURIS

      #####
      # Subnode: Mark
      #####
*/

      if (
         (global_var(GVAR_MET_MARK_GANNON) == 1) and
         (global_var(GVAR_MARK_DEAD) != 1)
      ) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_MARK, 1);
      end

/*

      #####
      # Subnode: Measles
      #####
      536, 1, 679, NAR_MEASL

      #####
      # Subnode: Otto
      #####
      537, 1, 680, NAR_OTTO

      #####
      # Subnode: S.O.R.-1000 Alpha
      #####
      538, 1, 681, NAR_SORA

      #####
      # Subnode: Xian
      #####
      539, 1, 682, NAR_XIAN

      #####
      # Prisoner
      #####
      540, 1, 683, NAR_PC1

*/

// Always set
set_global_var(GVAR_ENDGAME_MOVIE_PC7, 1);
set_global_var(GVAR_ENDGAME_MOVIE_PC8, 1);

// Did we follow Presper or not?
if (global_var(GVAR_FOLLOW_PRESPER) == 1) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_PC4, 1);
end
else begin
   set_global_var(GVAR_ENDGAME_MOVIE_PC3, 1);
end

// Did we destroy or make it impossible for the Battalion leadership to escape B.O.M.B.-001?
if (
   (global_var(GVAR_BOMB001_SIF_COUNTDOWN) != 0) or
   (global_var(GVAR_BOMB001_OVERLOAD_COUNTDOWN) != 0) or
   (global_var(GVAR_BOMB001_BLOW_UP_COUNTDOWN) != 0)
) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_PC5, 1);
end

// Pure evil Prisoner
if (has_rep_demon_spawn and has_rep_berserker and has_rep_childkiller) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_PC6, 1);
end

// Bonus Fallout cities
// Target ID of 0 means we don't track these cities in MAPS.H so we need to check for missile disabled-enabled status too

/*
#####
# Subnode: Shady Sands
#####
*/
if ((global_var(GVAR_BOMB001_M3_TARGET) == 0) and (global_var(GVAR_BOMB001_M3_DISABLED) == 0)) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_NCRN, 1);
end

/*
#####
# Subnode: New Reno
#####
*/
if ((global_var(GVAR_BOMB001_M4_TARGET) == 0) and (global_var(GVAR_BOMB001_M4_DISABLED) == 0)) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_NRN, 1);
end

/*
#####
# Subnode: Flagstaff
#####
*/
if ((global_var(GVAR_BOMB001_M4_TARGET) == 999) and (global_var(GVAR_BOMB001_M4_DISABLED) == 0)) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_FLG, 1);
end

/*
#####
# Subnode: Vault City
#####
*/
if ((global_var(GVAR_BOMB001_M5_TARGET) == 0) and (global_var(GVAR_BOMB001_M5_DISABLED) == 0)) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_VCN, 1);
end

/*
#####
# Subnode: Lost Hills Bunker
#####
*/
if ((global_var(GVAR_BOMB001_M7_TARGET) == 0) and (global_var(GVAR_BOMB001_M7_DISABLED) == 0)) then begin
   set_global_var(GVAR_ENDGAME_MOVIE_BOSN, 1);
end

end
