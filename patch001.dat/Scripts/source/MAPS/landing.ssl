      #####
      423, 1, 454, NAR_BF1
      424, 1, 455, NAR_BF2
      425, 1, 456, NAR_BF3
      426, 1, 457, NAR_BF4
*/
      if (global_var(GVAR_BOMB001_M1_TARGET) == AREA_BLACKFOOT) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_BF5, 1);
         remove_from_map(AREA_BLACKFOOT)
         mark_on_map(AREA_BLACKFOOT_NUKED)
      end
/*

      #####
      # Hangdogs
      #####
      477, 1, 624, NAR_HNGD1
      478, 1, 625, NAR_HNGD2

      #####
      # Twin Mothers
      #####
      513, 1, 656, NAR_TM1
      514, 1, 657, NAR_TM2
      516, 1, 659, NAR_TM4
*/
   if (global_var(GVAR_BOMB001_M7_TARGET) == AREA_TWIN_MOTHERS) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_TM3, 1);
      remove_from_map(AREA_TWIN_MOTHERS)
      mark_on_map(AREA_TWIN_MOTHERS_NUKED)
   end
/*

      #####
      # Ouroboros
      #####
      502, 1, 647, NAR_OU1
      503, 1, 648, NAR_OU2
      504, 1, 649, NAR_OU3
*/

    if (global_var(GVAR_BOMB001_M4_TARGET) == AREA_OUROBOROS) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_OU4, 1);
      remove_from_map(AREA_OUROBOROS)
      mark_on_map(AREA_OUROBOROS_NUKED)
    end

/*
      #####
      # Mesa Verde
      #####
      487, 1, 634, NAR_MV2
      488, 1, 635, NAR_MV3

*/
    if (global_var(GVAR_BOMB001_M7_TARGET) == AREA_MESA_VERDE) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_MV5, 1);
      remove_from_map(AREA_MESA_VERDE)
      mark_on_map(AREA_MESA_VERDE_NUKED)
    end
    else if (global_var(GVAR_CIPHERS_DEAD) == 1) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_MV4, 1);
    end
    else if (global_var(GVAR_QUEST_DEAL_WITH_HOUNDS) <= DEAL_WITH_HOUNDS_SIEGE) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_MV1, 1);
    end
    else if (global_var(GVAR_QUEST_DEAL_WITH_HOUNDS) > DEAL_WITH_HOUNDS_SIEGE) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_MV6, 1);
    end
/*
      #####
      # The Nursery
      #####
      495, 1, 640, NAR_TN1
      496, 1, 641, NAR_TN2
      497, 1, 642, NAR_TN3
      499, 1, 644, NAR_TN4
      500, 1, 645, NAR_TN6
*/

    if (global_var(GVAR_BOMB001_M5_TARGET) == AREA_THE_NURSERY) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_TN5, 1);
      remove_from_map(AREA_THE_NURSERY)
      mark_on_map(AREA_THE_NURSERY_NUKED)
    end
/*
      #####
      # Maxson Bunker
      #####
      438, 1, 593, NAR_BOS1
      441, 1, 595, NAR_BOS3
      444, 1, 598, NAR_BOS6

*/
   if (global_var(GVAR_BOMB001_M8_TARGET) == AREA_BROTHERHOOD_OF_STEEL) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_BOS2, 1);
      remove_from_map(AREA_BROTHERHOOD_OF_STEEL)
      mark_on_map(AREA_BROTHERHOOD_OF_STEEL_NUKED)
   end
   else if(global_var(GVAR_BROTHERHOOD_DEAD) == 1) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_BOS5, 1);
   end
   else if (global_var(GVAR_COS_KILLED) < 20) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_BOS4, 1);
   end


/*
      #####
      # New Canaan
      #####
*/
   if (global_var(GVAR_BOMB001_M2_TARGET) == AREA_NEW_CANAAN) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_NC1, 1);
      remove_from_map(AREA_NEW_CANAAN)
      mark_on_map(AREA_NEW_CANAAN_NUKED)
   end
/*
      #####
      # Jericho
      #####
      479, 1, 626, NAR_JR1
      480, 1, 627, NAR_JR2
      482, 1, 629, NAR_JR4
      483, 1, 630, NAR_JR5
      484, 1, 631, NAR_JR6
*/
    if (global_var(GVAR_BOMB001_M2_TARGET) == AREA_JERICHO) then begin
