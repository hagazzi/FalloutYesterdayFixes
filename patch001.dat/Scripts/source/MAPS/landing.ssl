      remove_from_map(AREA_JERICHO)
      mark_on_map(AREA_JERICHO_NUKED)
    end

/*
      #####
      # Burham Springs
      #####
      448, 1, 599, NAR_BS1
      450, 1, 600, NAR_BS2
      451, 1, 601, NAR_BS3
      452, 1, 602, NAR_BS4
      454, 1, 603, NAR_BS5

*/
    if (global_var(GVAR_BOMB001_M2_TARGET) == AREA_BURHAM_SPRINGS) then begin
       set_global_var(GVAR_ENDGAME_MOVIE_BS6, 1);
       remove_from_map(AREA_BURHAM_SPRINGS)
       mark_on_map(AREA_BURHAM_SPRINGS_NUKED)
    end
/*

      #####
      # Hoover Dam
      #####
      471, 1, 618, NAR_HD1

*/
      if (global_var(GVAR_BOMB001_M1_TARGET) == AREA_HOOVER_DAM) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_HD2, 1);
         remove_from_map(AREA_HOOVER_DAM)
         mark_on_map(AREA_HOOVER_DAM_NUKED)
      end
      else if (ncr_bos_war_ended and (global_var(GVAR_DODGE_ASSASSINATED) == 0) and (global_var(GVAR_BROTHERHOOD_DEAD) == 0)) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_HD3, 1);
      end
      else if (not(ncr_bos_war_ended) and (global_var(GVAR_DODGE_ASSASSINATED) == 0) and (global_var(GVAR_BROTHERHOOD_DEAD) == 0)) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_HD4, 1);
      end
      else if ((global_var(GVAR_HD_SMOOCH_STATUS) == SMOOCH_HIGH) or (global_var(GVAR_HD_SMOOCH_STATUS) == SMOOCH_ALL)) then begin
         set_global_var(GVAR_ENDGAME_MOVIE_HD6, 1);
      end
      else begin
         set_global_var(GVAR_ENDGAME_MOVIE_HD5, 1);
      end

/*


      #####
      # Fort Abandon
      #####
      432, 1, 463, NAR_FA1
      433, 1, 464, NAR_FA2
      434, 1, 465, NAR_FA3
      435, 1, 466, NAR_FA4
*/

    if (global_var(GVAR_BOMB001_M8_TARGET) == AREA_FORT_ABANDON) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_FA5, 1);
      remove_from_map(AREA_FORT_ABANDON)
      mark_on_map(AREA_FORT_ABANDON_NUKED)
    end
    else if (global_var(GVAR_FA_EMPTY) == 1) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_FA2, 1);
    end
    else if (
      (global_var(GVAR_BOMB001_M8_TARGET) != AREA_BROTHERHOOD_OF_STEEL) and
      (global_var(GVAR_BROTHERHOOD_DEAD) == 0) and
      (global_var(GVAR_COS_KILLED) >= 20) and
      (global_var(GVAR_QUEST_GET_RID_OF_CAESARS_LEGION) != 2)
      ) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_FA3, 1);
   end
   else if (global_var(GVAR_QUEST_GET_RID_OF_CAESARS_LEGION) != 2) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_FA4, 1);
   end
   else if (global_var(GVAR_QUEST_GET_RID_OF_CAESARS_LEGION) == 2) then begin
      set_global_var(GVAR_ENDGAME_MOVIE_FA1, 1);
   end


/*

      #####
      # The Reservation
      #####
      506, 1, 651, NAR_TR1
      508, 1, 653, NAR_TR3
      511, 1, 654, NAR_TR4
      512, 1, 655, NAR_TR5
*/

    if (global_var(GVAR_BOMB001_M3_TARGET) == AREA_THE_RESERVATION) then begin
