procedure Dumb_healed
begin

fadeout(1);
critter_heal(dude_obj, Injured_How_Much(dude_obj));
critter_uninjure(dude_obj, (DAM_CRIP_LEG_LEFT bwor DAM_CRIP_LEG_RIGHT bwor DAM_CRIP_ARM_LEFT bwor DAM_CRIP_ARM_RIGHT));
poison(dude_obj, -get_poison(dude_obj));
radiation_dec(dude_obj, 500);
game_time_advance(ONE_GAME_HOUR * random(2,12));
fadein(1);

Reply(2660);
NOption(2661,Dumb_healed_payment,-3);
end

procedure Dumb_healed_payment
begin
Reply(2690);
NOption(2691,dumb_pay,-3);
end

// Node dumb_pay
//
// Notes:
//
// Davide's price should be about 10% lower than other doctors' standard prices because he is a nice guy. :-)

procedure dumb_pay
begin
Reply(2720);
NOption(2721,dumb_pay_check,-3);
end

procedure dumb_pay_check
begin
Reply(2750);
// NOTE: This option only visible if the PC has enough caps to pay Davide's fee.
if(dude_caps >= 50) then
NOption(1371,Dumb_pay_check_success,-3);
// NOTE: this option only visible if the PC does not have enough to pay Davide's fee.
if(dude_caps < 50) then
NOption(1371,dumb_pay_check_fail,-3);
end

// Node dumb_pay_check_fail
//
// Notes:
//
// remove all caps from the player's inventory.

procedure dumb_pay_check_fail
begin
   set_local_var(LVAR_Poor, 1);
Reply(2780);
NOption(2781,Node999,-3);
end

// Node Dumb_pay_check_success
//
// Notes:
//
// remove the earlier specified caps from the players inventory

procedure Dumb_pay_check_success
begin
   item_caps_adjust(dude_obj, -50);
   set_local_var(LVAR_Poor, 0);
Reply(2810);
NOption(2781,Node999,-3);
end

