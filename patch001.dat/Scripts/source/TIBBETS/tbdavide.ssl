procedure Dumb_Hurt
begin
Reply(2420);
// NOTE: This option should only be visible if the player is wounded.
if(Is_Hurt(dude_obj)) then
NOption(1371,Dumb_Hurt_1,-3);
// NOTE: This option should only be visible if the player is poisoned.
if(dude_is_poisoned) then
NOption(1371,Dumb_Hurt_2,-3);
// NOTE: This option should only be visible if the player is radiated.
if(dude_is_irradiated) then
NOption(1371,Dumb_Hurt_3,-3);
// NOTE: This option should only be visible if the player is injured and poisoned.
if(dude_is_poisoned and Is_Hurt(dude_obj)) then
NOption(1371,Dumb_Hurt_4,-3);
// NOTE: This option should only be visisble if the player is wounded and radiated.
if(dude_is_irradiated and Is_Hurt(dude_obj)) then
NOption(1371,Dumb_Hurt_5,-3);
// NOTE: This option should only be visible if the player is poisoned and radiated.
if(dude_is_poisoned and dude_is_irradiated and not(Is_Hurt(dude_obj))) then
NOption(1371,Dumb_Hurt_6,-3);
// NOTE: This option should only be visible if the player is wounded, poisoned, and radiated.
if(dude_is_poisoned and dude_is_irradiated and Is_Hurt(dude_obj)) then
NOption(1371,Dumb_Hurt_7,-3);
end

