procedure initial
begin
Reply(380);
NOption(mstr(381)+dude_name+mstr(382),davide1,4);
// NOTE: This option should only be visible if the PC is slightly injured, slightly poisoned, or has taken a small dose of radiation.
if(random(1,2) == 1) then begin
   if(dude_is_poisoned or dude_is_irradiated or Is_Hurt(dude_obj)) then
   NOption(mstr(383)+dude_name+mstr(384),davide2,4);
end else begin
   // NOTE: This option should only be visible if the PC is heavily injured, heavily poisoned, or has taken a large dose of radiation.
   if(dude_is_poisoned or dude_is_irradiated or Is_Hurt(dude_obj)) then
   NOption(mstr(385)+dude_name+mstr(386),davide3,4);
end
// NOTE: This option should only be visible if the PC has any wounded, poisoned, or radiated party members present.
If_Party_Has_Injured then
NOption(mstr(387)+dude_name+mstr(388),davide4,4);
NOption(389,Node999,4);
// NOTE: This option only visible if the player is stupid and injured, radiated, or poisoned.
if(dude_is_poisoned or dude_is_irradiated or Is_Hurt(dude_obj)) then
NOption(390,Dumb_Hurt,-3);
NOption(391,Dumb_unhurt,-3);

if(global_var(GVAR_QUEST_ASYLUM_RADSCORPIONS) == 500 or global_var(GVAR_QUEST_ASYLUM_RADSCORPIONS) == 1000) then begin
   NOption(392,RadReward,4);
   NOption(393,RadReward,-3);
end
end

// Node subsequent
//
// Notes:
//
// This should be the starting node for any subsequant conversations that Davide and the PC may have after the PC has talked to Davide once.

procedure subsequent
begin
Reply(410);
// NOTE: This option should only be visible if the PC is injured, radiated, or poisoned.
if(dude_is_poisoned or dude_is_irradiated or Is_Hurt(dude_obj)) then
NOption(411,davide2,4);
NOption(412,AQ,4);
NOption(413,RedoHistory,4);
// NOTE: This option should only be visible if the PC has a companion NPC who is wounded, radiated, or poisoned.
If_Party_Has_Injured then
NOption(414,davide4,4);
NOption(415,Node999,4);
NOption(416,Gestalt1,4);
// NOTE: This option not visible if the player could not afford to pay Davide's fee earlier.
if(local_var(LVAR_Poor) == 0) then
NOption(417,Dumb_Hurt,-3);
NOption(418,Dumb_unhurt,-3);
end

