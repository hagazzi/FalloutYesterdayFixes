procedure RadReward begin
   item_caps_adjust(dude_obj, global_var(GVAR_QUEST_ASYLUM_RADSCORPIONS));
   set_global_var(GVAR_QUEST_ASYLUM_RADSCORPIONS, 0);

   Reply(2870);
NOption(593,Node999,4);
NOption(2661,Node999,-3);


end

