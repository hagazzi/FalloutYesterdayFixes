/* Include Files */


//Overrides the pickup p proc.
//#define NPC_REACTION_TYPE       REACTION_TC /* REACTION_TC REACTION_TG REACTION_C REACTION_G */
#define NPC_REACTION_VAR        7 /* same as thief variable */

#include "..\HEADERS\define.h"

#define NAME                    SCRIPT_TBEYEBRK

// NOTE: This is set to 0 by default
#define TOWN_REP_VAR             (0)
#define GENERATOR_DOOR           (obj_blocking_tile(25494, 2, BLOCKING_TYPE_BLOCK))

#include "..\HEADERS\command.h"
#include "..\HEADERS\ModReact.h"
#include "..\HEADERS\party.h"
#include "..\HEADERS\vault8.h"
#include "..\headers\updatmap.h"

/* Helper macros */

variable temp;

/* Standard Script Procedures */
procedure start;
procedure critter_p_proc;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure use_skill_on_p_proc;
procedure damage_p_proc;
procedure map_enter_p_proc;
procedure timed_event_p_proc;
procedure FullRepair;

/* Script Specific Procedure Calls */
procedure Node998;                                      // This Node is Always Combat
procedure Node999;                                      // This Node is Always Ending


// The Following lines are for anything that is not needed to be
// seen by the design Tool


/* Local Variables which are saved. All Local Variables need to be
   prepended by LVAR_ */
#define LVAR_Herebefore                 (4)
#define LVAR_Hostile                    (5)
#define LVAR_Personal_Enemy             (6)
#define LVAR_Caught_Thief               (7)
#define LVAR_Broken                     (8)



/* Imported variables from the Map scripts. These should only be
   pointers and variables that need not be saved. If a variable
   Needs to be saved, make it a map variable (MVAR_) */


/* Local variables which do not need to be saved between map changes. */
variable Only_Once:=0;

procedure start begin
end

/* This procedure will get called each time that the map is first entered. It will
   set up the Team number and AI packet for this critter. This will override the
   default from the prototype, and needs to be set in scripts. */
procedure map_enter_p_proc begin
   Only_Once:=0;
   add_timer_event(self_obj,game_ticks(random(1,5)),0);

   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_VAULT8);

   if(local_var(LVAR_Broken) < 2) then begin
      reg_anim_clear(self_obj);
      reg_anim_begin();
      reg_anim_animate(self_obj, ANIM_fall_front, -1);
      reg_anim_end();
   end
end


/* Every heartbeat that the critter gets, this procedure will be called. Anything from
   Movement to attacking the player on sight can be placed in here.*/
procedure critter_p_proc begin

if(elevation(self_obj) == elevation(dude_obj)) then begin

   // fixed
   if(local_var(LVAR_Broken) == 2) then begin

      if(map_var(MVAR_POWER) == 1) then begin
         animate_move_to_tile(pick_one(17712, 23264));
         return;
      end

      // move to door
      if(
         (tile_num(self_obj) != 24894) and
         (map_var(MVAR_POWER) == 0) and
         obj_is_locked(GENERATOR_DOOR)
      ) then begin
         animate_move_to_tile(24894);
      end
      else begin
         // door locked
         if(obj_is_locked(GENERATOR_DOOR)) then begin
            // complain
            if((random(1, 150) == 1)) then begin
               dialogue_system_enter;
               animate_rotation(2);
            end
         end else begin
            // move
            if(tile_num(self_obj) != 26496) then begin
               animate_move_to_tile(26496);
            end else begin
               animate_rotation(0);
               fadeout(600);

                game_time_advance(ONE_GAME_HOUR);

               fadein(600);
               set_map_var(MVAR_POWER, 1);
               set_global_var(GVAR_QUEST_FIX_GENERATOR, 2);
               Full_Light;
               floater_good(207);
               display_mstr(150);
               give_xp(150);
               play_sfx("genstart");
            end
         end
      end
   end

/* If the critter is mad at the player for any reason, it will attack and remember to attack
   the player should the game be saved and loaded repeatedly. Additionally, if any special
   actions need to be taken by the critter based on previous combat, the critter will remember
   this as well. */

   if ((local_var(LVAR_Hostile) != 0) and (self_can_see_dude or self_can_hear_dude) and local_var(LVAR_Broken) == 2) then begin
       set_local_var(LVAR_Hostile,1);
       self_attack_dude;
       //Macro made by Tom to keep the critter fleeing.
   end

end

end

/* Whenever the critter takes damage of any type, this procedure will be called. Things
   like setting ENEMY_ and LVAR_Personal_Enemy can be set here. */
procedure damage_p_proc begin

/* If the player causes damage to this critter, then he will instantly consider the player
   his personal enemy. In Critter_Proc or through dialog, actions will be taken against
   the player for his evil acts. */
   if (obj_in_party(source_obj)) then begin
       set_local_var(LVAR_Personal_Enemy,1);
   end

end

/* Any time that the player is caught stealing from this critter, Pickup_proc will be called.
   In here, various things can happen. The most common response is instant hostility which
   will be remembered. */
procedure pickup_p_proc begin
   if (source_obj == dude_obj) then begin
       set_local_var(LVAR_Hostile,2);
   end
end

/* The dialog system is setup and prepares the player to talk to this NPC. Where To Go
   written by designers are placed in here. Additionally, Reactions are generated and
   stored which affects player interactions. */
procedure talk_p_proc begin
   Evil_Critter:=0;
   Slavery_Tolerant:=SLAVE_TOLERANT;
   Karma_Perception:=KARMA_PERCEPTION1;

   CheckKarma;

   GetReaction;

   if(local_var(LVAR_Broken) == 0) then begin
       floater_bad_rand(200, 203);
       if((self_elevation == dude_elevation) and (self_distance_from_dude <= 10)) then begin
         play_sfx("ebotbrkn");
       end
   end
   else if (local_var(LVAR_Broken) == 1) then begin
       floater_bad(204);
       if((self_elevation == dude_elevation) and (self_distance_from_dude <= 10)) then begin
          play_sfx("ebotbrkn");
       end
   end
   else if (local_var(LVAR_Broken) == 2) then begin
      if(map_var(MVAR_POWER) == 0 and (tile_num(self_obj) != 24894) and obj_is_locked(GENERATOR_DOOR)) then begin
       floater_bad(205);
      end
      else if(map_var(MVAR_POWER) == 0 and (tile_num(self_obj) == 24894)) then begin
       floater_bad(206);
      end
       else if(map_var(MVAR_POWER) == 1) then begin
          if(map_var(MVAR_LIFE) == 0) then
            floater_bad(208);
          else
            floater_good_rand(209,210);
       end

   end

call Node999;
end

procedure timed_event_p_proc begin

 if (random(1, 4) == 1) then begin
    dialogue_system_enter;
   end

   add_timer_event(self_obj,game_ticks(random(3, 5)),0);

end

/* This procedure gets called only on the death of this NPC. Special things like
   incrementing the death count for reputation purposes and Enemy Counters are placed
   in here. */
procedure destroy_p_proc begin

/* Increment the aligned critter counter*/
   inc_neutral_critter
/* Set global_variable for Enemy status*/
end

/* Look_at_p_proc gets called any time that the player passes the cursor over any object.
   This should only hold the most cursory of glances for the player. */
procedure look_at_p_proc begin
   script_overrides;
   if (local_var(LVAR_Herebefore) == 0) then
      display_mstr(100);
   else
      display_mstr(101);
end

/* The player will see more indepth descriptions from this procedure. They are actively
   looking at the critter and want more information. Things like names can be added here
   if the critter is known to the player. */
procedure description_p_proc begin
   script_overrides;
   display_mstr(102);
end

/* Any time a skill is used on a critter this call is made. This can be to give examinations
   for things like Doctor skill or messages for various other skills. */
procedure use_skill_on_p_proc begin
   variable roll1, roll2;

   if (
   action_being_used == SKILL_REPAIR
   ) then begin
       script_overrides;

roll1 := roll_vs_skill(source_obj, SKILL_REPAIR, 0);
roll2 := roll_vs_skill(source_obj, SKILL_REPAIR, -25);

if(local_var(LVAR_Broken) == 0) then begin
   if(is_success(roll1)) then begin
         if(is_critical(roll1)) then begin
            call FullRepair;
            return;
         end else begin
            set_local_var(LVAR_Broken, 1);
            dialogue_system_enter;
            return;
         end
      end else begin
         if(is_critical(roll1)) then begin
            critter_dmg(self_obj, random(150, 300), DMG_electrical);
            display_msg(mstr(151) + " " + obj_name(self_obj) + " " + mstr(152));
         end else begin
            display_msg(mstr(153) + " " + obj_name(self_obj) + ".");
            return;
         end
      end
   end
if(local_var(LVAR_Broken) == 1) then begin
   if(is_success(roll2)) then begin
         call FullRepair;
         return;
      end else begin
         if(is_critical(roll2)) then begin
            critter_dmg(self_obj, random(150, 300), DMG_electrical);
            display_msg(mstr(151) + " " + obj_name(self_obj) + " " + mstr(152));
         end else begin
            display_msg(mstr(153) + " " + obj_name(self_obj) + ".");
            return;
         end
      end
end

      if(skill_success(source_obj, SKILL_REPAIR, -50) and local_var(LVAR_Broken) == 2) then begin
         display_msg(mstr_skill(603) + " " + obj_name(self_obj) + " " + mstr_skill(605));
		   give_xp(25);
         critter_dmg(self_obj, critter_skill_level(source_obj, SKILL_REPAIR), DMG_electrical);
      end else begin
         display_msg(mstr_skill(604) + " " + obj_name(self_obj) + " " + mstr_skill(605));
         set_local_var(LVAR_Hostile,2);
      end

   end else if (action_being_used == SKILL_SCIENCE) then begin
      script_overrides;

      if(skill_success(source_obj, SKILL_SCIENCE, -20)) then begin
         if(local_var(LVAR_Broken) == 2) then
            display_mstr(154);
         else
            display_mstr(155);
      end else begin
         display_msg(mstr_skill(602));
      end
      // can't steal
   end else if (action_being_used == SKILL_STEAL) then begin
       script_overrides;
   end

end

procedure FullRepair begin
   set_local_var(LVAR_Broken, 2);
   dialogue_system_enter;
   give_xp(100);
   display_mstr(300);
   set_global_var(GVAR_QUEST_REPAIR_FEB, 2);
   display_msg(message_str(SCRIPT_VAULT8, 112));
   play_sfx("SIMTEK9");
   critter_heal(self_obj, max_hits(self_obj) - cur_hits(self_obj));
end

/* Should the Player ever cause the NPC too much discomfort that he desires to attack the player,
   this call will be made. Essentially, it stores the Hostile vaule so that the critter remembers
   he was once hostile towards the player.*/
procedure Node998 begin
   set_local_var(LVAR_Hostile,2);
end

/* Anytime that there is a need for an ending to dialog, this node is to be called. It will just
   exit from the dialog system without any reprisals from the NPC. */
procedure Node999 begin
//debug_msg("LVAR_Herebefore == "+local_var(LVAR_Herebefore));
if (local_var(LVAR_Herebefore)==0) then
begin
set_local_var(LVAR_Herebefore,1);
end
end

// Skill checks and miscellaneous procedures
