// Node Angela_9F_3
//
// Notes:
//
// We need to decide what level we're going to set the karma level, x, mentioned in the player options, which decides if Angela will let the PC in on her secret.

procedure Angela_9F_3
begin
Reply(2240);
// NOTE: This option appears if the PC's karma is above a certain level, x, AND the local variable Angela_Temper is at 0 or above.
if (local_var(LVAR_Angela_Temper)>=0) then
NOption(1401,Angela_2a_7a_4a,4);
// NOTE: This option appears if the PC's karma is above a certain level, x, but the local variable Angela_Temper is below 0.
if (local_var(LVAR_Angela_Temper)<0) then
NOption(1401,Angela_9F_4,4);
end

