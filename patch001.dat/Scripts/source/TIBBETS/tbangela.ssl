// Notes:
//
// The Angela_1a_* path is the default greeting Angela uses when she speaks to the PC for the first time. It branches after this node depending on whether she finds the PC attractive.

procedure Angela_1a_1
begin
Reply(650);
if (get_critter_stat(dude_obj,STAT_ch)<7) then
NOption(mstr(651)+dude_name+mstr(652),Angela_1a_2Ma_1,4);
if (get_critter_stat(dude_obj,STAT_ch)>=7) then
GOption(mstr(651)+dude_name+mstr(652),Angela_1a_2F_1a,4);
if (get_critter_stat(dude_obj,STAT_ch)<7) then
NOption(653,Angela_1a_2Mb_1,4);
if (get_critter_stat(dude_obj,STAT_ch)>=7) then
NOption(653,Angela_1a_2F_1b,4);
if (get_critter_stat(dude_obj,STAT_ch)<7) then
NOption(mstr(654)+dude_name+mstr(655),Angela_1a_2Ma_1,-3);
if (get_critter_stat(dude_obj,STAT_ch)>=7) then
GOption(mstr(654)+dude_name+mstr(655),Angela_1a_2F_1a,-3);
if (get_critter_stat(dude_obj,STAT_ch)<7) then
NOption(656,Angela_1a_2Mb_1,-3);
if (get_critter_stat(dude_obj,STAT_ch)>=7) then
NOption(656,Angela_1a_2F_1b,-3);
end

