// Node Angela_2a_1
//
// Notes:
//
// The Angela_2a_* path is where the PC can try to get Angela to date any one of several CotC NPC's. Any attempt to do this is doomed to fail, but in taking this path, the PC can find out that Angela is a lezza.

procedure Angela_2a_1
begin
Reply(1700);
if(global_var(GVAR_KNOW_MAGIK) == 1) then
NOption(1701,Angela_2a_2a_1,4);
if(global_var(GVAR_KNOW_CROZ) == 1) then
NOption(1702,Angela_2a_2b_1,4);
if(global_var(GVAR_ANGELA_GABRIELLE) == 1) then
NOption(1703,Angela_2a_2c_1,4);
if(global_var(GVAR_KNOW_ALDO) == 1) then
NOption(1704,Angela_2a_2d_1,4);
if (dude_is_male) then
NOption(1705,Angela_2a_2M_1,4);
NOption(1706,Node999,4);
end

procedure Angela_2a_2a_1
begin
set_global_var(GVAR_ANGELA_MAGIK_DATE, 1);
Reply(1730);
NOption(1731,Angela_2a_2a_2,4);
NOption(1732,Angela_2a_3,4);
if (get_critter_stat(dude_obj,STAT_ch)<7) or (dude_is_female) then
NOption(1733,Angela_9M,4);
if (get_critter_stat(dude_obj,STAT_ch)>=7) and (dude_is_male) then
NOption(1733,Angela_9F_1,4);
NOption(1734,Node999,4);
end

procedure Angela_2a_2a_2
begin
Reply(1760);
NOption(1732,Angela_2a_3,4);
if (get_critter_stat(dude_obj,STAT_ch)<7) or (dude_is_female) then
NOption(1733,Angela_9M,4);
