roll_temp := roll_vs_skill(dude_obj, SKILL_CONVERSANT, -10);
if is_success(roll_temp) then
begin
call Node031;
end
else begin
call Node027;
 end
end


procedure giveMoney begin
item_caps_adjust(dude_obj,1000);
call Node014;

end

procedure giveMoney2 begin
item_caps_adjust(dude_obj,1000);
call Node015;

end



