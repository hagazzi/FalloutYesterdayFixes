procedure Node999_go begin
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   call Node999;
   fadein(1);
   give_xp(100);
end

procedure Node999_follow begin
   fadeout(1);
   set_local_var(LVAR_Follow, 1);
   critter_attempt_placement(dude_obj, 19161, 0);
   critter_attempt_placement(self_obj, 19161, 0);
   call Node999;
   fadein(1);
   give_xp(100);
end


