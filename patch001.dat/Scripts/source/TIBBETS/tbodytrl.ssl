   NOption(2415,Node999,1);
end

procedure Node075
begin

   if (global_var(GVAR_QUEST_FIND_PRISONERS) == 1) then begin
      set_global_var(GVAR_ONLY_13_LEFT, 14);
      set_global_var(GVAR_QUEST_FIND_PRISONERS, 2);
      set_global_var(GVAR_KNOW_VEHICLE_DEPOT, 1);
      give_xp(10000);
      display_mstr(2420);
   end
   Reply(2416);
   NOption(2415,Node999,1);
end

procedure update_pipboy(variable quest_gvar)
begin
   give_xp(1000);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(quest_gvar);
   call Node999;
end

procedure update_location(variable quest_gvar)
begin
   give_xp(500);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(quest_gvar);
   call Node999;
end

procedure update_pipboy_presper begin

   inc_global_var(GVAR_QUEST_FIND_PIERCE);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_COLERIDGE);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_DAVIDSON);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_BRIGGS);
   inc_global_var(GVAR_ONLY_13_LEFT);

   call update_pipboy(GVAR_QUEST_FIND_VICTOR_PRESPER);

   display_msg(mstr(2421) + " " + mstr(2422) + ".");
end

procedure update_location_presper begin

   inc_global_var(GVAR_QUEST_FIND_PIERCE);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_COLERIDGE);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_DAVIDSON);
   inc_global_var(GVAR_ONLY_13_LEFT);
   inc_global_var(GVAR_QUEST_FIND_BRIGGS);
   inc_global_var(GVAR_ONLY_13_LEFT);

   call update_location(GVAR_QUEST_FIND_VICTOR_PRESPER);

   display_msg(mstr(2421) + " " + mstr(2422) + ".");
end

procedure update_location_jean begin
   call update_location(GVAR_QUEST_FIND_JEAN_BAPTISTE_CUTTING);
   display_msg(mstr(2421) + " " + mstr(2423) + ".");
end

procedure update_location_jill begin
   call update_location(GVAR_QUEST_FIND_JILLIAN_MCKINLEY);
