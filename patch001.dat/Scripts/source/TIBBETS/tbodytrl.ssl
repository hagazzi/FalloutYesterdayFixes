procedure Node074
begin

if (global_var(GVAR_ONLY_13_LEFT) == 13) then
   Reply(2418);
else if (global_var(GVAR_ONLY_13_LEFT) == 12) then
   Reply(mstr(2390)+ " " +mstr(2392));
else
   Reply(mstr(2390) + " " + (13 - global_var(GVAR_ONLY_13_LEFT)) + " " + mstr(2391));

   if (global_var(GVAR_QUEST_FIND_VICTOR_PRESPER) < 2) then begin
      if (global_var(GVAR_KNOW_LOCATION_PRESPER) == 1) then
         NOption(2393,update_location_presper,1);
      if (dude_item_count(PID_PIERCE_LIL_PIP_3000)>0) then
         NOption(2417,update_pipboy_presper,1);
   end

   if (global_var(GVAR_QUEST_FIND_JEAN_BAPTISTE_CUTTING) < 2) then begin
      if (dude_item_count(PID_JEAN_BAPTISTE_CUTTING_LIL_PIP_3000)>0) then
         NOption(2398,update_pipboy_jean,1);
      if (global_var(GVAR_KNOW_LOCATION_JEAN) == 1) then
         NOption(2399,update_location_jean,1);
   end

   if (global_var(GVAR_QUEST_FIND_JILLIAN_MCKINLEY) < 2) then begin
      if (dude_item_count(PID_JILLIAN_MCKINLEY_LIL_PIP_3000)>0) then
         NOption(2400,update_pipboy_jill,1);
      if (global_var(GVAR_KNOW_LOCATION_JILLIAN) == 1) then
         NOption(2401,update_location_jill,1);
   end

   if (global_var(GVAR_QUEST_FIND_CHAGAS) < 2) then begin
      if (dude_item_count(PID_CHAGAS_LIL_PIP_3000)>0) then
         NOption(2402,update_pipboy_chagas,1);
      if (global_var(GVAR_KNOW_LOCATION_CHAGAS) == 1) then
         NOption(2403,update_location_chagas,1);
   end

   if (global_var(GVAR_QUEST_FIND_BLACKJACK) < 2) then begin
      if (dude_item_count(PID_BLACKJACK_LIL_PIP_3000)>0) then
         NOption(2404,update_pipboy_blackjack,1);
      if (global_var(GVAR_KNOW_LOCATION_BLACKJACK) == 1) then
         NOption(2405,update_location_blackjack,1);
   end

   if (global_var(GVAR_QUEST_FIND_DANIEL) < 2) then begin
      if (dude_item_count(PID_DANIEL_LIL_PIP_3000)>0) then
         NOption(2406,update_pipboy_daniel,1);
      if (global_var(GVAR_KNOW_LOCATION_DANIEL) == 1) then
         NOption(2407,update_location_daniel,1);
   end

   if (global_var(GVAR_QUEST_FIND_MALLET_MCBRIDE) < 2) then begin
      if (dude_item_count(PID_MALLET_MCBRIDE_LIL_PIP_3000)>0) then
         NOption(2408,update_pipboy_mallet,1);
      if (global_var(GVAR_KNOW_LOCATION_MALLET) == 1) then
         NOption(2409,update_location_mallet,1);
   end

   if (global_var(GVAR_QUEST_FIND_GINGER_FLOWERS) < 2) then begin
      if (dude_item_count(PID_GINGER_FLOWERS_LIL_PIP_3000)>0) then
         NOption(2410,update_pipboy_ginger,1);
      if (global_var(GVAR_KNOW_LOCATION_GINGER) == 1) then
         NOption(2411,update_location_ginger,1);
   end

   if (global_var(GVAR_QUEST_FIND_AKEISHA_MOON) < 2) then begin
      if (dude_item_count(PID_AKEISHA_MOON_LIL_PIP_3000)>0) then
         NOption(2412,update_pipboy_akeisha,1);
