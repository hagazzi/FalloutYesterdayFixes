procedure Node001
begin
Reply(200);
NOption(201,Node002,1);
if (get_critter_stat(dude_obj,STAT_iq)>=7) or (has_skill(dude_obj,SKILL_SCIENCE)>=50) then
NOption(202,Node007,6);
if (get_critter_stat(dude_obj,STAT_iq)>=7) or (has_skill(dude_obj,SKILL_REPAIR)>=50) then
NOption(203,Node007,6);
if (has_skill(dude_obj,SKILL_REPAIR)>=50) or (has_skill(dude_obj,SKILL_SCIENCE)>=50) then
NOption(204,Node007,-3);
NOption(205,Node999,1);
end

