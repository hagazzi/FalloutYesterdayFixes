procedure Node008
begin
Reply(410);
if(global_var(GVAR_VT_HOLOGRAM) == 2) then begin
   NOption(411,Node018,4);
   NOption(413,Node018,-3);
end else begin
   NOption(411,StartSimTek5000,4);
   NOption(413,StartSimTek5000,-3);
end

if(map_var(MVAR_KNOW_CODES) == 1) then
NOption(412,Node009,1);
if(global_var(GVAR_QUEST_VAULT_BOY) == 1 and global_var(GVAR_HOLODISK_VAULT_BOY) == 0 and (obj_is_carrying_obj_pid(dude_obj,PID_LIL_PIP_3000)>0)) then begin
   if (has_skill(dude_obj,SKILL_SCIENCE)>=75) then begin
      NOption(416,VaultBoyDownload,1);
   end else begin
      NOption(416,Node018,1);
   end

   if (has_skill(dude_obj,SKILL_REPAIR)>=75) then begin
      NOption(417,VaultBoyRepair,1);
   end else begin
      NOption(417,Node023,1);
   end

end
NOption(414,Node999,4);
NOption(415,Node999,-3);
end

