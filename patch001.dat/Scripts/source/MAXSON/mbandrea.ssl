procedure TalkIll
begin

Reply(290);
if(local_var(LVAR_Diagnosis) == 0) then
NOption(291,WhoIs,4);
else begin
// NOTE: increment LVAR_Rad_Away
if (local_var(LVAR_Rad_Away)==0 and (obj_is_carrying_obj_pid(dude_obj,PID_RADAWAY)>0)) then
NOption(292,RadAway5,4);
// NOTE: increment LVAR_Rad_Away
if (local_var(LVAR_Rad_Away)==1 and (obj_is_carrying_obj_pid(dude_obj,PID_RADAWAY)>0)) then
NOption(293,RadAway4,4);
// NOTE: increment LVAR_Rad_Away
if (local_var(LVAR_Rad_Away)==2 and (obj_is_carrying_obj_pid(dude_obj,PID_RADAWAY)>0)) then
NOption(294,RadAway3,4);
// NOTE: increment LVAR_Rad_Away
if (local_var(LVAR_Rad_Away)==3 and (obj_is_carrying_obj_pid(dude_obj,PID_RADAWAY)>0)) then
NOption(295,RadAway2,4);
// NOTE: increment LVAR_Rad_Away
if (local_var(LVAR_Rad_Away)==4 and (obj_is_carrying_obj_pid(dude_obj,PID_RADAWAY)>0)) then
NOption(296,RadAway1,4);
end
NOption(297,Node999,4);
end

procedure Cured
begin
Reply(mstr(320)+dude_name+mstr(321));
NOption(322,HowAreYou,4);
NOption(323,Node999,4);
if(global_var(GVAR_QUEST_FIND_POISONER) == 2) then
NOption(324,Node025,4);
if ((town_visible_on_map(AREA_CIRCLE_OF_STEEL) and global_var(GVAR_COS_KILLED) < MIN_COS_KILLED and global_var(GVAR_QUEST_FIND_CIRCLE_OF_STEEL) == 1)) then
NOption(325,Node030,4);
if ((town_visited(AREA_CIRCLE_OF_STEEL) and global_var(GVAR_COS_KILLED) >= MIN_COS_KILLED and (obj_is_carrying_obj_pid(dude_obj,PID_STEALTH_BOY) >= MIN_COS_KILLED) and global_var(GVAR_QUEST_FIND_CIRCLE_OF_STEEL) == 1)) then
NOption(326,Node034_take_stealth,4);
if ((town_visited(AREA_CIRCLE_OF_STEEL) and global_var(GVAR_COS_KILLED) >= MIN_COS_KILLED and global_var(GVAR_QUEST_FIND_CIRCLE_OF_STEEL) == 1)) then
   NOption(327,Node034,4);
if (town_known(AREA_BOULDER_DOME) and (AreaNukeStatus(AREA_BOULDER_DOME) == AREA_BOULDER_DOME)) then begin
   GOption(328,Node035,4);
   // TODO BOS in charge of Boulder Dome
   //BOption(329,Node038,4);
   GOption(330,Node035,-3);
   //TODO BOS in charge of Boulder Dome
   //BOption(331,Node038,-3);
end

if (global_var(GVAR_BLEW_UP_HOOVER_DAM) == 1) then begin
   NOption(332,Node039,4);
   NOption(333,Node039,-3);
end
else if (
   (global_var(GVAR_QUEST_OPERATION_PEACEMAKER) == QUEST_ACCEPTED) and
   (global_var(GVAR_QUEST_HOOVER_PEACE) == QUEST_COMPLETED)
   ) then begin
   GOption(334,Node039,4);
   GOption(335,Node039,-3);
end

if ((global_var(GVAR_QUEST_CIPHERS_URANIUM) == QUEST_KNOWN) or (global_var(GVAR_QUEST_CIPHERS_URANIUM) == QUEST_ACCEPTED)) then begin
   GOption(336,Node046,4);
   GOption(337,Node046,-3);
end

end

