   inc_bos_rep(5);
   set_global_var(GVAR_QUEST_CIPHERS_URANIUM, QUEST_COMPLETED);
   give_xp(250);

Reply(1550);
NOption(1551,Node999,4);
NOption(1552,Node999,-3);
end
