procedure Node021 //Mechanic Upgrades List
begin
	Reply(852);
	if (vehicle_fuelup == 0) then
		NOption(853,Node021a,4);
	if (vehicle_blower == 0) or (vehicle_nrupgrade == 0)  then		
		NOption(854,Node021b,4);
	if (car_carry_amount < vehicle_cargo_third_breakpoint) then		
		NOption(855,Node021c,4);
	if 
	   (global_var(GVAR_BROTHERHOOD_SENIOR) == 1) and 
	   (car_carry_amount == vehicle_cargo_third_breakpoint) and 
	   (vehicle_super == 0) and 
	   (vehicle_blower == 1) and 
	   (vehicle_nrupgrade == 1) and 
	   (vehicle_fuelup == 1)
	then begin
		NOption(856,Node021d,4);
	end
	NOption(857,Node011,4);
end

