procedure Node022
begin
	variable pct_gas := ((car_gas_amount / 800));
	Reply("Ah it looks like your vehicle only has "+pct_gas+"% left, i'm gonna assign one of our initiates to refuel your vehicle...");
	variable refuelamount := (80000 - car_gas_amount);
	item_caps_adjust(dude_obj,-1000);
	car_give_gas(refuelamount);
	NOption(1031,Node001,4);
end

//Upgrades from Otto

procedure node023 //upgrade if stupid
begin

if (dude_item(PID_PLASMA_RIFLE)) then
begin
inven_unwield(dude_obj);
remove_pid_qty(dude_obj,PID_PLASMA_RIFLE, 1)
give_pid_qty(dude_obj,PID_TURBO_PLASMA_RIFLE , 1)
Reply(750);
end
else
if dude_item(PID_LASER_RIFLE) then
begin
inven_unwield(dude_obj);
remove_pid_qty(dude_obj,PID_LASER_RIFLE, 1)
give_pid_qty(dude_obj,PID_LASER_RIFLE_EXT_CAP, 1)
Reply(749);
end
else
if dude_item(PID_HUNTING_RIFLE) then
begin
inven_unwield(dude_obj);
remove_pid_qty(dude_obj,PID_HUNTING_RIFLE, 1)
give_pid_qty(dude_obj,PID_SCOPED_HUNTING_RIFLE, 1)
Reply(743);
end
else
if dude_item(PID_FN_FAL) then
begin
inven_unwield(dude_obj);
remove_pid_qty(dude_obj,PID_FN_FAL, 1)
give_pid_qty(dude_obj,PID_FN_FAL_NIGHT_SCOPE, 1)
