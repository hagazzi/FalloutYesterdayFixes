procedure EnterBOS begin
   call Node999;
   set_global_var(GVAR_WELCOME_BOS, 1);
   create_object(PID_BLOCKING_HEX, 16490, 0);
//   use_obj(tile_contains_pid_obj(16290, 0, 33556317)); // numberless Vault door
   Enter_BOS = 1;
end

procedure StupidLeave begin

   call Node999;

   fadeout(1);
   move_to(dude_obj, 17490, 0);
   create_object(PID_BLOCKING_HEX, 16490, 0);
   use_obj(tile_contains_pid_obj(16290, 0, 33556317)); // numberless Vault door
   set_global_var(GVAR_WELCOME_BOS, -1);
   set_obj_visibility(self_obj, 1);
   fadein(1);

end


