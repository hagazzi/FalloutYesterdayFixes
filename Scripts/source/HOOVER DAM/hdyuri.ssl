// Node Node030
//
// Notes:
//
// Replace X with the appropriate amount of money to treat the character's medical problems.

procedure Node030
begin

fadeout(1);
game_time_advance(random(1,10) * ONE_GAME_MINUTE);
fadein(1);

variable amt, cnd;
amt = 5;
cnd = mstr(154);

if(dude_is_poisoned) then begin
   amt = 50;
   cnd = mstr(152);
end else if(dude_is_irradiated) then begin
   amt = 500;
   cnd = mstr(151);
end else if(Is_Injured(dude_obj)) then begin
   amt = 200;
   cnd = mstr(150);
end else if(Is_Crippled(dude_obj)) then begin
   amt = 1000;
   cnd = mstr(155);
end else if(dude_is_addicted_to_jet) then begin
   amt = 25;
   cnd = mstr(156);
end else if(dude_is_addicted_to_smooch) then begin
   amt = 25;
   cnd = mstr(157);
end else if(dude_is_addicted) then begin
   amt = 0;
   cnd = mstr(153);
end

// free price means normal addiction
if (amt == 0) then begin
   if (dude_is_male) then
   Reply(mstr(1070)+mstr(1078));
else if (dude_is_female) then
   Reply(mstr(1072)+mstr(1078));

   NOption(1079,Node003,4);
   NOption(1080,Node999,4);

// we're gonna charge the player for something
end else begin
   if (dude_is_male) then
      Reply(mstr(1070)+cnd+mstr(1071)+amt+mstr(1077));
   else if (dude_is_female) then
      Reply(mstr(1072)+cnd+mstr(1071)+amt+mstr(1077));

   if (dude_caps >= amt) then
      NOption(1073,Node031,4);
   NOption(1074,Node003,4);
   NOption(1075,Node999,4);
   NOption(1076,Node999,4);
end
end

