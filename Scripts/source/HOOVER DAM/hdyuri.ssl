// Notes:
//
// Heal the character back to a fully healthy status.

procedure Node032
begin
if(dude_is_poisoned) then begin
   call HealPlayer(16, 50, HEAL_POISON, 1);
end else if(dude_is_irradiated) then begin
   call HealPlayer(12, 500, HEAL_RADIATION, 1);
end else if(Is_Injured(dude_obj)) then begin
   call HealPlayer(1, 200, HEAL_HP, 1);
end else if(Is_Crippled(dude_obj)) then begin
   call HealPlayer(48, 1000, HEAL_CRIPPLE, 1);
end else if(dude_is_addicted_to_jet) then begin
   item_caps_adjust(dude_obj, -25);
   fadeout(1);
   give_pid_qty(dude_obj, PID_JET_ANTIDOTE, 1)
   use_item_on_dude(obj_carrying_pid_obj(dude_obj, PID_JET_ANTIDOTE));
   fadein(1);
end else if(dude_is_addicted_to_smooch) then begin
   item_caps_adjust(dude_obj, -25);
   fadeout(1);
   give_pid_qty(dude_obj, PID_SMOOCH_ANTIDOTE, 1)
   use_item_on_dude(obj_carrying_pid_obj(dude_obj, PID_SMOOCH_ANTIDOTE));
   fadein(1);
end
else begin
   fadeout(1);
   item_caps_adjust(dude_obj, -5);
   fadein(1);
end

Reply(1130);
NOption(1131,Node003,4);
NOption(1132,Node999,4);
end

