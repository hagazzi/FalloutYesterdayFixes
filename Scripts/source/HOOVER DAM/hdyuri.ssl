procedure NodeDoDermal begin
   variable item, price;

   price = 5500;
   if (local_var(LVAR_Gave_Discount) == 2) then begin
      price = 4950;
   end

   if ((dude_caps >= price) and (dude_has_combat_armor) ) then begin
      item_caps_adjust(dude_obj,-price);
      call RemoveCombatArmor;
      critter_add_trait(dude_obj,TRAIT_PERK,PERK_dermal_armor_perk,1);
      game_time_advance(2*ONE_GAME_DAY);
      fadeout(600);
      fadein(600);
      call Node072;
   end else begin
      call Node071;
   end
end

procedure NodeDoDermalUpgrade begin
   variable item, price;

   price = 33000;
   if (local_var(LVAR_Gave_Discount) == 2) then begin
      price = 29700;
   end

   if ((dude_caps >= price) and (dude_has_combat_armor)) then begin
      item_caps_adjust(dude_obj,-price);
      call RemoveCombatArmor;
      critter_rm_trait(dude_obj,TRAIT_PERK,PERK_dermal_armor_perk,1); // Seraph's Code
      critter_add_trait(dude_obj,TRAIT_PERK,PERK_dermal_enhancement_perk,1);
      game_time_advance(5*ONE_GAME_DAY);
      fadeout(600);
      fadein(600);
      call Node072;
   end else begin
      call Node071;
   end
end

procedure NodeDoPhoenix begin
   variable item, price;

   price = 8500;
   if (local_var(LVAR_Gave_Discount) == 2) then begin
      price = 7650;
   end

   if ((dude_caps >= price) and (dude_has_combat_armor)) then begin
      item_caps_adjust(dude_obj,-price);
      call RemoveCombatArmor;
      critter_add_trait(dude_obj,TRAIT_PERK,PERK_phoenix_armor_perk,1);
      game_time_advance(3*ONE_GAME_DAY);
      fadeout(600);
      fadein(600);
      call Node072;
   end else begin
      call Node071;
   end
end

procedure NodeDoPhoenixUprade begin
   variable item, price;

   price = 49000;
   if (local_var(LVAR_Gave_Discount) == 2) then begin
      price = 44100;
   end

   if ((dude_caps) >= price and (dude_has_combat_armor)) then begin
      item_caps_adjust(dude_obj,-price);
      call RemoveCombatArmor;
      critter_rm_trait(dude_obj,TRAIT_PERK,PERK_phoenix_armor_perk,1); // Seraph's Code
      critter_add_trait(dude_obj,TRAIT_PERK,PERK_phoenix_enhancement_perk,1);
      game_time_advance(4*ONE_GAME_DAY);
      fadeout(600);
      fadein(600);
      call Node072;
   end else begin
      call Node071;
   end
end

procedure DudeFleeOutside begin
   variable tile;
   tile = 14876;

   closest_clear_tile(dude_obj, 14876, tile)
   animate_move_obj_to_tile(dude_obj, tile, (ANIMATE_RUN bwor ANIMATE_INTERRUPT));
end

procedure DudeFleeOutsideDialog begin
   set_local_var(LVAR_DudeFleeOutside, 1);
   call Node999;
end

procedure TakeDrugs begin
   remove_pid_qty(dude_obj, PID_STIMPAK, 20)
   remove_pid_qty(dude_obj, PID_SUPER_STIMPAK, 20)
   remove_pid_qty(dude_obj, PID_RADAWAY, 10)
   remove_pid_qty(dude_obj, PID_MENTATS, 10)
   remove_pid_qty(dude_obj, PID_BUFFOUT, 10)
   give_xp(1000);
   display_mstr(158);
   set_global_var(GVAR_RESTOCK_DR_YURI, 2);
end

procedure RemoveCombatArmor begin

   if (dude_item(PID_COMBAT_ARMOR)) then begin
      remove_pid_qty(dude_obj, PID_COMBAT_ARMOR, 1)
   end
   else if (dude_item(PID_BROTHERHOOD_COMBAT_ARMOR)) then begin
      remove_pid_qty(dude_obj, PID_BROTHERHOOD_COMBAT_ARMOR, 1)
   end
   else if (dude_item(PID_HERMES_ARMOR)) then begin
      remove_pid_qty(dude_obj, PID_HERMES_ARMOR, 1)
   end
   else if (dude_item(PID_HERMES_ARMOR_MK_II)) then begin
      remove_pid_qty(dude_obj, PID_HERMES_ARMOR_MK_II, 1)
   end
   else if (dude_item(PID_NCR_RANGER_COMBAT_ARMOR)) then begin
      remove_pid_qty(dude_obj, PID_NCR_RANGER_COMBAT_ARMOR, 1)
   end
   else if (dude_item(PID_NCR_ARMOR)) then begin
      remove_pid_qty(dude_obj, PID_NCR_ARMOR, 1)
   end
   else if (dude_item(PID_COMBAT_ARMOR_MK_II)) then begin
      remove_pid_qty(dude_obj, PID_COMBAT_ARMOR_MK_II, 1)
   end

end

