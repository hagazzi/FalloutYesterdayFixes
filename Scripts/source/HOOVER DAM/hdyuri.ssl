// Node Node018
//
// Notes:
//
// Once the quest has been accepted to get drugs for the good doctor, remove option 3 ("Why is your stock so low?"), and any other conversation options that result in Doc or the player propositioning for the quest.

procedure Node018
begin

   if (global_var(GVAR_QUEST_HOOVER_PEACE) == QUEST_COMPLETED) then
      gdialog_mod_barter(-30);
   else
      gdialog_barter;

Reply(710);
// NOTE: Speech test, if successful the doc gives the PC 2 stimpaks and tells him that's all he can spare at the moment, and this text option is permanently removed.  This one links to the successful one.
if (local_var(LVAR_Gave_Stimpaks) == 0) then
NOption(711,Skill_Check_001_Speech,4);
if (global_var(GVAR_RESTOCK_DR_YURI) == 0) then
NOption(712,Node021,4);
NOption(713,Node003,4);
NOption(714,Node999,4);
end

procedure Skill_Check_001_Speech begin
   if is_success(roll_vs_skill(dude_obj, SKILL_CONVERSANT, -25)) then
      call Node019;
   else
      call Node020;
end

