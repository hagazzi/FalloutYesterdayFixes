   (global_var(GVAR_AILIS_DODGE_MEET_OK) == 1) and
   (global_var(GVAR_QUEST_MEET_DODGE) == 1)
   ) then
   NOption(2001,Node058,4);

if (global_var(GVAR_QUEST_AILIS_EVIDENCE) == CC_INFILTRATION_DONE) then
   NOption(2002,Node056,4);

if (global_var(GVAR_QUEST_UPGRADE_FILTER) == FILTRATION_SCHEMATICS_FOUND) then begin
   if (global_var(GVAR_DUDE_FIXED_WATER_FILTER) == 1) then
      NOption(2003,Node057,4);
