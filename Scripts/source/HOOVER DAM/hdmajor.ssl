procedure start_cc_arrest begin
   fadeout(1);
   set_global_var(GVAR_CC_ARREST, CC_ARREST_ASSIST);
   Only_Once = 1;
   call Node999;
end

procedure drink_redrum begin
   fadeout(1);
   game_time_advance(ONE_GAME_HOUR);

   reg_anim_clear(dude_obj);
   reg_anim_begin();
   reg_anim_animate(dude_obj,ANIM_fall_front,-1);
   reg_anim_animate(dude_obj,ANIM_prone_to_standing,-1);
   reg_anim_end();

   fadein(1);
   call Node999;
end

procedure groom_dogs begin
   fadeout(1);
   game_time_advance(ONE_GAME_HOUR * 3);
   fadein(1);
   display_mstr(150);
   call Node999;
end

