procedure Make_Inven begin
   variable item;

   if (random(1,20) <= 15) then begin
       item:=create_object(PID_AFTER_BURNER_GUM,0,0);
       add_mult_objs_to_inven(self_obj,item,random(2,5));
   end

   if (random(1,20) <= 10) then begin
       item:=create_object(PID_PSYCHO,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,3));
   end

   if (random(1,20) <= 3) then begin
       item:=create_object(PID_SUPER_STIMPAK,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 5) then begin
       item:=create_object(PID_GREASE_GUN,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 7) then begin
       item:=create_object(PID_223_FMJ,0,0);
       add_mult_objs_to_inven(self_obj,item,random(2,3));
   end

   if (random(1,20) <= 1) then begin
       item:=create_object(PID_LEATHER_ARMOR_MK_II,0,0);
       add_mult_objs_to_inven(self_obj,item,1);
   end

   if (random(1,20) <= 2) then begin
       item:=create_object(PID_COMBAT_SHOTGUN,0,0);
       add_mult_objs_to_inven(self_obj,item,1);
   end

   if (random(1,20) <= 3) then begin
       item:=create_object(PID_MICRO_FUSION_CELL,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 5) then begin
       item:=create_object(PID_SPIKED_KNUCKLES,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 10) then begin
       item:=create_object(PID_ROPE,0,0);
       add_mult_objs_to_inven(self_obj,item,random(2,3));
   end

   if (random(1,20) <= 3) then begin
       item:=create_object(PID_SCOPED_HUNTING_RIFLE,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 4) then begin
       item:=create_object(PID_BALL_AND_CHAIN_WEAPON,0,0);
       add_mult_objs_to_inven(self_obj,item,random(1,2));
   end

   if (random(1,20) <= 15) then begin
       item:=create_object(PID_BUFFOUT,0,0);
       add_mult_objs_to_inven(self_obj,item,random(2,5));
   end

   if (random(1,20) <= 10) then begin
       item:=create_object(PID_COMBAT_KNIFE,0,0);
       add_mult_objs_to_inven(self_obj,item,random(2,3));
   end

   if (random(1,20) <= 6) then begin
       item:=create_object(PID_FRAG_GRENADE,0,0);
       add_mult_objs_to_inven(self_obj,item,random(3,5));
   end
end

