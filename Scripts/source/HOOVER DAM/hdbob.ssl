procedure Bounties begin
   if (dude_chasing_a_bounty) then
      call Node016;
   else if (global_var(GVAR_QUEST_12_CRAIG_BOUNTY) == QUEST_NONE) then
      call Node004;
   else if (global_var(GVAR_QUEST_12_MIGUEL_BOUNTY) == QUEST_NONE) then
      call Node006;
   else if (global_var(GVAR_QUEST_12_NANCY_BOUNTY) == QUEST_NONE) then
      call Node008;
   else if (global_var(GVAR_QUEST_12_INGMAR_BOUNTY) == QUEST_NONE) then
      call Node010;
   else if (global_var(GVAR_QUEST_12_KYLE_BOUNTY) == QUEST_NONE) then
      call Node012;
   else if (global_var(GVAR_QUEST_12_RYAN_BOUNTY) == QUEST_NONE) then
      call Node014;
   else
      call Node043;
end

