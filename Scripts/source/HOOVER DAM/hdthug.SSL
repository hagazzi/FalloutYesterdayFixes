/* Include Files */
#include "..\headers\define.h"

#define NAME                        SCRIPT_HDTHUG
#define TOWN_REP_VAR                GVAR_TOWN_REP_HOOVER_DAM

#include "..\headers\command.h"
#include "..\headers\ModReact.h"
#include "..\headers\hddtne.h"

/* Standard Script Procedures */
procedure start;
procedure critter_p_proc;
procedure pickup_p_proc;
procedure talk_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure use_skill_on_p_proc;
procedure damage_p_proc;
procedure map_enter_p_proc;
procedure combat_p_proc;

procedure Node001;
procedure Node002;
procedure Node003;
procedure Node998;                                      // This Node is Always Combat
procedure Node999;
procedure Node999a;
procedure Node999b;
procedure Speech01;

#define LVAR_Flags                      (4)
#define LVAR_Home_Tile                  (5)

#define BAR_FIGHT_DIPLOMACY_START_TALK                (1)
#define BAR_FIGHT_DIPLOMACY_TALKING                   (2)
#define BAR_FIGHT_DIPLOMACY_SUCCESS                   (3)
#define BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_BEA           (4)
#define BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_DUDE          (5)

variable looked_at_thug;

import variable BeatriceBouncer;

procedure start begin
end

procedure timed_event_p_proc begin
   if (self_can_see_dude) then begin
      if (random(0,1) == 1) then begin
         if (dude_is_male) then
            float_msg(self_obj, mstr(random(200,209)), FLOAT_COLOR_BAD);
         else
            float_msg(self_obj, mstr(random(300,311)), FLOAT_COLOR_BAD);
      end
   end
   flush_add_timer_event_sec(self_obj, random(15, 60), 0);
end

procedure map_enter_p_proc begin
   if (is_loading_game == false) then begin
      if (map_first_run) then begin
         critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM, TEAM_DUSTY_DESIRES_THUGS);
         critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_AI_PACKET, AI_THUG);
      end else if (global_var(GVAR_QUEST_HELP_BEATRICE) != HELP_BEATRICE_BAR_FIGHT_IS_ON) then begin
         set_obj_visibility(self_obj, 1);
      end
      flush_add_timer_event_sec(self_obj, random(15, 60), 0);
   end
end

procedure critter_p_proc begin

   if (hostile and self_can_see_dude) then begin
      self_attack_dude;
   end
   else if (
      (map_var(MVAR_Dead_Bar_Fight_Thugs) >= 2) or
      (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_FAILED)
      ) then begin
      if (self_tile != 9118) then begin
         anim_run_to_point(9118)
      end
      else begin
         set_obj_visibility(self_obj, 1);
         destroy_object(self_obj);
      end
   end
   else if (map_var(MVAR_Bar_Fight_Diplomacy) == BAR_FIGHT_DIPLOMACY_START_TALK and self_can_speak and self_can_see_dude) then begin
      dialogue_system_enter;
   end
   else if (map_var(MVAR_Bar_Fight_Diplomacy) == BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_BEA and not(is_critter_dead(BeatriceBouncer)) and not(combat_is_initialized)) then begin
      self_attack_critter(BeatriceBouncer);
   end else if ((map_var(MVAR_Bar_Fight_Diplomacy) == BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_DUDE) and not(combat_is_initialized)) then begin
      set_hostile;
   end

end

procedure damage_p_proc begin
   if (source_obj == dude_obj) then begin
      call Node998;
      inc_map_var(MVAR_Dude_Helped_Beatrice);
   end
end

procedure pickup_p_proc begin
   if (source_obj == dude_obj) then begin
      call Node998;
   end
end

procedure talk_p_proc
begin

   Evil_Critter:=1;
   Slavery_Tolerant:=SLAVE_TOLERANT;
   Karma_Perception:=KARMA_PERCEPTION1;

   CheckKarma;

   GetReaction;

   if (map_var(MVAR_Bar_Fight_Diplomacy) == BAR_FIGHT_DIPLOMACY_START_TALK) then begin
      set_map_var(MVAR_Bar_Fight_Diplomacy, BAR_FIGHT_DIPLOMACY_TALKING);
      call set_idiot_savant_int;
      start_gdialog(NAME, self_obj, 4, -1, -1);
      gsay_start;
      call node001;
      gsay_end;
      end_dialogue;
      call restore_idiot_savant_int;
   end
   else if (dude_is_male) then
      float_msg(self_obj, mstr(random(200,209)), FLOAT_COLOR_BAD);
   else
      float_msg(self_obj, mstr(random(300,311)), FLOAT_COLOR_BAD);

end

procedure destroy_p_proc begin
   inc_evil_critter
   inc_map_var(MVAR_Dead_Bar_Fight_Thugs);
end

procedure look_at_p_proc begin
   script_overrides;
   if (looked_at_thug == false) then begin
      looked_at_thug := true;
      flush_add_timer_event_sec(self_obj, random(1, 3), 0);
   end
   display_mstr(100);
end

procedure description_p_proc begin
   script_overrides;
   if (looked_at_thug == false) then begin
      looked_at_thug := true;
      flush_add_timer_event_sec(self_obj, random(1, 3), 0);
   end
   display_mstr(101);
end

procedure combat_p_proc begin
   if (map_var(MVAR_Dead_Bar_Fight_Thugs) >= 2) then begin
      off_hostile;
      terminate_combat;
      float_msg(self_obj, mstr(150), FLOAT_COLOR_AFRAID);
      if (is_critter_dead(BeatriceBouncer)) then
         flee_from_tile(dude_tile)
      else
         flee_from_tile(tile_num(BeatriceBouncer))
   end
   else if (not(critter_is_fleeing(self_obj))) then begin
      if (random(1, 100) <= 20) then begin
         if (dude_is_male) then
            float_msg(self_obj, mstr(random(200, 209)), FLOAT_COLOR_BAD);
         else
            float_msg(self_obj, mstr(random(300, 311)), FLOAT_COLOR_BAD);
      end
   end
end

procedure use_skill_on_p_proc begin
   call injure_with_skill;
end

procedure Node998 begin
   set_hostile;
end

procedure Node999 begin
end

procedure Node001 begin
   Reply(400);
   BOption(401, Node002, 4);
   GOption(402, Node999a, 4);
end

procedure Node999a begin
   set_map_var(MVAR_Bar_Fight_Diplomacy, BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_BEA);
   call Node999;
end

procedure Node999b begin
   set_map_var(MVAR_Bar_Fight_Diplomacy, BAR_FIGHT_DIPLOMACY_FAIL_ATTACK_DUDE);
   call Node999;
end

procedure Node002 begin
   Reply(403);
   if (dude_item(PID_RADIO)) then
      BOption(mstr(404) + " " + mstr(406), Node003, 4);
   if (dude_item(PID_LIL_PIP_3000)) then
      BOption(mstr(405) + " " + mstr(406), Speech01, 4);
   // This should never happen but just in case
   else
      BOption(406, Node999b, 4);
end

procedure Node003 begin
   set_map_var(MVAR_Bar_Fight_Diplomacy, BAR_FIGHT_DIPLOMACY_SUCCESS);
   set_map_var(MVAR_Dead_Bar_Fight_Thugs, 2);
   inc_map_var(MVAR_Dude_Helped_Beatrice);
   Reply(407);
   NOption(g_mstr(350), Node999, 4);
end

procedure Node004 begin
   call Node999a;
   Reply(408);
   NOption(g_mstr(350), Node999, 4);
end

procedure Speech01 begin
   // -50% drunkenness, -10% for each nearby thug
   if (is_success(roll_vs_skill(dude_obj, SKILL_CONVERSANT, -80))) then begin
      call Node003;
   end
   else begin
      call Node004;
   end
end
