/* Change "Beatrice" to match the name of your new critter */
#define Beatrice_joins_party             party_add_self;                                                   \
                                               critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_PLAYER)
#define dude_has_free_slot_for_Beatrice  ((dude_at_max_party_size == false) and (Beatrice_In_Party == false))

/*****************************************************************
   Local Variables which are saved.
   All Local Variables need to be prepended by LVAR_

      To have LVars work, open scripts.LST, scroll to your character's script name,
      and change the "LVars" setting to at least 8,
      Since there are 8 Local Variables used below.

      (LVAR_ 0 thru 3 are reserved for NPC Reaction Modifiers...
      ...will add more instructions when I learn how they work.)
*****************************************************************/
#define LVAR_Flags                      (4)
#define LVAR_WAITING                    (5)
#define LVAR_FOLLOW_DISTANCE            (6)
#define LVAR_TEAM                       (7)
#define LVAR_Joined_Player              (8)
#define LVAR_Caught_Thief               (9)

/*****************************************************************
      If you would rather use the LVAR_Hostile, LVAR_Herebefore, LVAR_Personal_Enemy
      variables instead of LVAR_Flags, uncomment the relevent lines and comment out
      lines with set_herebefore, set_hostile, if (hostile) and (self_can_see_dude).
*****************************************************************/
//#define LVAR_Hostile                    (9)
#define LVAR_Herebefore                 (10)
//#define LVAR_Personal_Enemy             (11)

#define PARTY_NODE_X                      Node1000

/*******************************************************************
   Imported variables from the Map scripts. These should only be
   pointers and variables that need not be saved. If a variable
   Needs to be saved, make it a map variable (MVAR_)
*******************************************************************/

import variable BeatriceBouncer;


/*******************************************************************
   Local variables which do not need to be saved between map changes.
*******************************************************************/
variable begin
end

/*******************************************************************
*                           PROCEDURES                             *
*******************************************************************/
procedure start begin
    BeatriceBouncer := self_obj;
end

procedure map_enter_p_proc begin
   /*  This procedure will get called each time that the map is first entered. It will
       set up the Team number and AI packet for this critter. This will override the
       default from the prototype, and needs to be set in scripts. */
    BeatriceBouncer := self_obj;

   //party_member_map_enter;

   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_PARTY_BEATRICE_CUSTOM);

   if
      (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_ASKED_TO_JOIN) or
      (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_BAR_FIGHT_IS_ON)
   then begin
      switch_team(self_obj, TEAM_DUSTY_DESIRES_WORKERS)
   end else begin
         if (cur_map_index == MAP_HOOVER_DAM_DOWNTOWN_NORTHEAST) then begin
            switch_team(self_obj, TEAM_HOOVER_DAM)
         end
   end

   call critter_setup_footsteps_map_enter(self_obj, WALKING_TICKS_SLOWER, RUNNING_TICKS_DEFAULT);
end

procedure map_update_p_proc begin
    BeatriceBouncer := self_obj;
 end

procedure timed_event_p_proc begin
   call critter_setup_footsteps_timed_event(self_obj, WALKING_TICKS_SLOWER, RUNNING_TICKS_DEFAULT, SFX_FOOTSTEP_HARD_SHOE);
end

procedure critter_p_proc begin
   /* Every heartbeat that the critter gets, this procedure will be called. Anything from
      Movement to attacking the player on sight can be placed in here.
      If the critter is mad at the player for any reason, it will attack and remember to attack
      the player should the game be saved and loaded repeatedly. Additionally, if any special
      actions need to be taken by the critter based on previous combat, the critter will remember
      this as well. */

//   if ((local_var(LVAR_Hostile) > 1) and (self_can_see_dude)) then begin
//      set_local_var(LVAR_Hostile,1);
   if (hostile) and (self_can_see_dude) then begin
      self_attack_dude; //Macro made by Tom to keep the critter fleeing.
   end
   else if (
         (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_BAR_FIGHT_IS_ON) and
         (map_var(MVAR_Dead_Bar_Fight_Thugs) >= 2) and
         (map_var(MVAR_Dude_Helped_Beatrice) >= 1) and
         self_can_see_dude and
         self_can_speak
         ) then begin
            dialogue_system_enter;
   end

   /* This next script moves the new party member to follow the player after they've joined and
      when entering new maps. */
   if (Beatrice_In_Party) then begin
      if (party_is_waiting == false) then begin
         party_member_follow_dude
      end
   end

   /*
   -----   These are examples of common Abandon_Party calls, use...or don't...at your discretion   -----

   else if (Beatrice_In_Party) then begin
      if (global_var(GVAR_PLAYER_REPUTATION) < Beatrice_Bad_Karma) then begin
         call Abandon_Party;
         //debug_msg("Beatrice Bad Player Rep");
      end
      else if (has_rep_childkiller) then begin
         call Abandon_Party;
         //debug_msg("Beatrice: Child Killer");
      end
      else if (has_rep_berserker) then begin
         call Abandon_Party;
         //debug_msg("Beatrice: Berserker");
      end
      else if (has_rep_slaver) then begin
         call Abandon_Party;
         //debug_msg("Beatrice: Slaver Rep");
      end*/

end

procedure damage_p_proc begin
   /* Whenever the critter takes damage of any type, this procedure will be called. Things
      like setting ENEMY_ and LVAR_Personal_Enemy can be set here.
      If the player causes damage to this critter, then he will instantly consider the player
      his personal enemy. In Critter_Proc or through dialog, actions will be taken against
      the player for his evil acts. */

   if (obj_in_party(source_obj)) then begin
//       set_local_var(LVAR_Personal_Enemy, 1);
      set_personal_enemy;
   end

end

procedure pickup_p_proc begin
   /* Any time that the player is caught stealing from this critter, Pickup_proc will be called.
      In here, various things can happen. The most common response is instant hostility which
      will be remembered. */

   if (source_obj == dude_obj) then begin
//      set_local_var(LVAR_Hostile, 2);
      set_hostile;
   end

end

procedure talk_p_proc begin

   /* The dialog system is setup and prepares the player to talk to this NPC. Where To Go
      written by designers are placed in here. Additionally, Reactions are generated and
      stored which affects player interactions. */
   Evil_Critter:=0;
   Slavery_Tolerant:=SLAVE_TOLERANT;
   Karma_Perception:=KARMA_PERCEPTION1;

   CheckKarma;

   GetReaction;
   call set_idiot_savant_int;

   start_gdialog(NAME,self_obj,4,HEAD_BEATRICE,BACKGROUND_JUNKTOWN);
   gSay_Start;

   if (
     (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_BAR_FIGHT_IS_ON) and
     not(combat_is_initialized) and
     (map_var(MVAR_Dead_Bar_Fight_Thugs) >= 2) and
     (map_var(MVAR_Dude_Helped_Beatrice) >= 1) and
     self_can_see_dude and
     self_can_speak
     ) then begin
      call Node009;
   end
   else if (
     (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_PROPOSED_TO_JOIN) or
     (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_DUSTY_OK))
    then begin
     call Node010;
   end
   else if ((Beatrice_Ptr != 0) or (party_is_waiting)) then begin
      call Node1000;
   end
   else if (local_var(LVAR_Herebefore) == 1) then begin
     call Node011;
   end
   else if (dude_is_super_mutant) then begin
      call Node013;
   end
    else begin
        call Node001;
    end

   gSay_End;
   end_dialogue;

call restore_idiot_savant_int;

end

procedure destroy_p_proc begin
   /* This procedure gets called only on the death of this NPC. Special things like
       incrementing the death count for reputation purposes and Enemy Counters are placed
       in here. */

       BeatriceBouncer := 0;

       if (
          (global_var(GVAR_QUEST_HELP_BEATRICE) == HELP_BEATRICE_BAR_FIGHT_IS_ON) and
          (cur_map_index == MAP_HOOVER_DAM_DOWNTOWN_NORTHEAST)
          ) then begin
          set_global_var(GVAR_QUEST_HELP_BEATRICE, HELP_BEATRICE_FAILED);

    /*      if (not(mckneely_dead)) then begin
             variable m;
             // ZZZ TODO script missing, needs to go away on map exit
             m = create_object_sid(PID_MITCH_STILLER,18343,self_elevation,-1);
             critter_add_trait(m,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_DUSTY_DESIRES_WORKERS);
             give_pid_qty(m, PID_ASSAULT_RIFLE, 1)
          end*/
       end

   /* Increment the aligned critter counter
        This counter affects your karma? */
   inc_neutral_critter

   /* Set global_variable for Enemy status*/
   set_global_var(GVAR_BEATRICE_DEAD, 1);

end

/* Look_at_p_proc gets called any time that the player passes the cursor over any object.
   This should only hold the most cursory of glances for the player. */
   procedure look_at_p_proc begin
      script_overrides;
      if (local_var(LVAR_Herebefore) == 0) then
         display_mstr(100);
      else
         display_mstr(101);
   end

/* The player will see more indepth descriptions from this procedure. They are actively
   looking at the critter and want more information. Things like names can be added here
   if the critter is known to the player. */
procedure description_p_proc begin
   script_overrides;
   display_mstr(102);
end

/* Any time a skill is used on a critter this call is made. This can be to give examinations
      for things like Doctor skill or messages for various other skills. */
procedure use_skill_on_p_proc begin
   call injure_with_skill;
end

procedure push_p_proc begin

    if (not(Beatrice_In_Party)) then begin
        floater_bad(680);
        call Node998;
     end
     else begin

         if (random(1, 3) == 1) then
            floater(650);                               // Float response for being pushed by player

     end

end

procedure Node998 begin
   /* Should the Player ever cause the NPC too much discomfort that he desires to attack the player,
       this call will be made. Essentially, it stores the Hostile vaule so that the critter remembers
       he was once hostile towards the player.*/
//   set_local_var(LVAR_Hostile,2);
   set_hostile;

end


/* Anytime that there is a need for an ending to dialog, this node is to be called. It will just
   exit from the dialog system without any reprisals from the NPC. */
   procedure Node999 begin
      //debug_msg("LVAR_Herebefore == "+local_var(LVAR_Herebefore));
      if (local_var(LVAR_Herebefore)==0) then
      begin
      set_local_var(LVAR_Herebefore,1);
      set_global_var(GVAR_KNOW_BEATRICE, 1);
      end
      end


