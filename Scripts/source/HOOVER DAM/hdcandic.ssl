procedure Node021
begin
   fadeout(1);
   game_time_advance(ONE_GAME_HOUR);
   fadein(1);

   if (dude_item(PID_HOLODISK_S1C)) then
      remove_pid_qty(dude_obj, PID_HOLODISK_S1C, 1)
   if (dude_item(PID_HOLODISK_S1C_DL)) then
      remove_pid_qty(dude_obj, PID_HOLODISK_S1C_DL, 1)
   if (dude_item(PID_HOLODISK_HD)) then
      remove_pid_qty(dude_obj, PID_HOLODISK_HD, 1)
   if (dude_item(PID_HOLODISK_HD_DL)) then
      remove_pid_qty(dude_obj, PID_HOLODISK_HD_DL, 1)

      set_global_var(GVAR_QUEST_HOOVER_HISTORY, QUEST_COMPLETED);
      give_xp(400);
      display_mstr(152);

Reply(1280);
NOption(1281,Node022,4);
end

