procedure TeachingStart
begin
   set_global_var(GVAR_QUEST_TEACH_CLASS, 1);
   Reply(770);
   GOption(771, StartCutscene, 4);
end

procedure TeachingEnd
begin
   variable totalxp = (20 * dude_iq) + (10 * dude_charisma);
   set_global_var(GVAR_QUEST_TEACH_CLASS, 2);
   give_xp(totalxp);
   display_mstr(151);
   inc_hoover_dam_rep(5);
   inc_general_rep(5);

   if (dude_charisma < 5) then begin
      Reply(830);
      NOption(831, Node999, 4);
   end
   else if (dude_is_smart) then begin
      Reply(800);
      NOption(803, Node999, 4);
   end
   else begin
      Reply(801);
      NOption(802, Node999, 4);
   end
end

procedure StartCutscene begin

   variable player_tile = 26682;
   variable candice_tile = 27077;

   fadeout(1);

   party_no_follow_on;
   reg_anim_clear(self_obj);

   // Clear out any previous floaters so they don't overlap
   float_msg(self_obj, " ", FLOAT_COLOR_NORMAL);
   float_msg(dude_obj, " ", FLOAT_COLOR_NORMAL);
   float_msg_clear(self_obj);
   float_msg_clear(dude_obj);

   move_to(dude_obj, player_tile, dude_elevation);
   critter_attempt_placement(dude_obj, player_tile, dude_elevation);
   move_to(self_obj, candice_tile, dude_elevation);
   critter_attempt_placement(self_obj, candice_tile, dude_elevation);
   Face_Critter(dude_obj, self_obj);
   tile_set_center(player_tile);

   add_timer_event(self_obj, game_ticks(1), 1);
   add_timer_event(self_obj, game_ticks(5), 2);
   add_timer_event(self_obj, game_ticks(10), 3);
   add_timer_event(self_obj, game_ticks(15), 4);
   add_timer_event(self_obj, game_ticks(20), 5);
   add_timer_event(self_obj, game_ticks(25), 6);
   add_timer_event(self_obj, game_ticks(30), 7);
   add_timer_event(self_obj, game_ticks(35), 8);
   add_timer_event(self_obj, game_ticks(40), 9);
   add_timer_event(self_obj, game_ticks(45), 10);
   add_timer_event(self_obj, game_ticks(50), 11);
   add_timer_event(self_obj, game_ticks(55), 12);
   add_timer_event(self_obj, game_ticks(60), 13);
   add_timer_event(self_obj, game_ticks(65), 14);
   add_timer_event(self_obj, game_ticks(70), 15);
   add_timer_event(self_obj, game_ticks(75), 16);
   add_timer_event(self_obj, game_ticks(80), 17);
   add_timer_event(self_obj, game_ticks(85), 18);
end

procedure RunClassCutscene begin
   variable c1 = obj_blocking_tile(27882, 0, BLOCKING_TYPE_AI);
   variable c2 = obj_blocking_tile(27880, 0, BLOCKING_TYPE_AI);
   variable c3 = obj_blocking_tile(28284, 0, BLOCKING_TYPE_AI);
   Face_Critter(c1, dude_obj);

   if (dude_charisma >= 5) then begin

      variable NormalIQ = 0;
      if (not(dude_is_smart)) then
         NormalIQ = 30;

      if(fixed_param == 1) then begin
         fadein(1);
         obj_floater_type(dude_obj, mstr(860 + NormalIQ), FLOAT_COLOR_NORMAL);
         game_ui_disable;
      end
      else if(fixed_param == 2) then
         obj_floater_type(c1, mstr(861 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 3) then
         obj_floater_type(dude_obj, mstr(862 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 4) then
         fadeout(1);
      else if(fixed_param == 5) then begin
         fadein(1);
         obj_floater_type(dude_obj, mstr(863 + NormalIQ), FLOAT_COLOR_NORMAL);
      end
      else if(fixed_param == 6) then
         obj_floater_type(c3, mstr(864 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 7) then
         obj_floater_type(dude_obj, mstr(865 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 8) then
         fadeout(1);
      else if(fixed_param == 9) then begin
         fadein(1);
         obj_floater_type(dude_obj, mstr(920 + NormalIQ), FLOAT_COLOR_NORMAL);
      end
      else if(fixed_param == 10) then
         obj_floater_type(c2, mstr(921 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 11) then
         obj_floater_type(dude_obj, mstr(922 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 12) then
         fadeout(1);
      else if(fixed_param == 13) then begin
         fadein(1);
         obj_floater_type(dude_obj, mstr(923 + NormalIQ), FLOAT_COLOR_NORMAL);
      end
      else if(fixed_param == 14) then
         obj_floater_type(c1, mstr(924 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 15) then
         obj_floater_type(dude_obj, mstr(925 + NormalIQ), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 16) then
         fadeout(1);
      else if(fixed_param == 17) then begin
         game_time_advance(ONE_GAME_HOUR * 2);
         fadein(1);
      end
      else begin
         party_no_follow_off;
         game_ui_enable;
         dialogue_system_enter;
      end
   end
   else begin

      variable FemaleLines = 0;
      if (dude_is_female) then
         FemaleLines = 30;

      if(fixed_param == 1) then begin
         fadein(1);
         obj_floater_type(dude_obj, mstr(980), FLOAT_COLOR_NORMAL);
         game_ui_disable;
      end
      else if(fixed_param == 2) then
         obj_floater_type(c3, mstr(981 + FemaleLines), FLOAT_COLOR_WHISPER);
      else if(fixed_param == 3) then
         obj_floater_type(c2, mstr(982 + FemaleLines), FLOAT_COLOR_WHISPER);
      else if(fixed_param == 4) then
         obj_floater_type(dude_obj, mstr(983), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 5) then
         obj_floater_type(c1, mstr(984), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 6) then
         obj_floater_type(dude_obj, mstr(985), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 7) then
         fadeout(1);
      else if(fixed_param == 8) then begin
         fadein(1);
         obj_floater_type(c3, mstr(986), FLOAT_COLOR_NORMAL);
      end
      else if(fixed_param == 9) then
         obj_floater_type(c1, mstr(987), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 10) then
         obj_floater_type(c2, mstr(988 + FemaleLines), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 11) then
         obj_floater_type(dude_obj, mstr(989), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 12) then
         obj_floater_type(c3, mstr(990), FLOAT_COLOR_NORMAL);
      else if(fixed_param == 13) then
         fadeout(1);
      else if(fixed_param == 14) then begin
         obj_floater_type(dude_obj, mstr(991), FLOAT_COLOR_SAD);
         fadein(1);
      end
      else begin
         game_time_advance(ONE_GAME_HOUR * 2);
         party_no_follow_off;
         game_ui_enable;
         dialogue_system_enter;
      end
   end

end

