/* Local Variables which are saved. All Local Variables need to be
   prepended by LVAR_ */
#define LVAR_Herebefore                 (4)
#define LVAR_Hostile                    (5)
#define LVAR_Personal_Enemy             (6)
#define LVAR_No_More_Caravans           (7)
#define LVAR_Paid4Ledger                (8)
#define LVAR_GoAwayTime                 (9)
#define LVAR_Node27Once                 (10)
#define LVAR_InJail                     (11)
#define LVAR_Infiltrated                (12)
#define LVAR_Recreate_Ledger_Once       (13)
#define LVAR_Frame_Enzo_Talk          (14)

/* Imported variables from the Map scripts. These should only be
   pointers and variables that need not be saved. If a variable
   Needs to be saved, make it a map variable (MVAR_) */


/* Local variables which do not need to be saved between map changes. */
variable Only_Once:=0;

import variable Ailis_Ptr;

procedure start begin
   Ailis_Ptr = self_obj;
end

/* This procedure will get called each time that the map is first entered. It will
   set up the Team number and AI packet for this critter. This will override the
   default from the prototype, and needs to be set in scripts. */
procedure map_enter_p_proc begin
   Only_Once:=0;
   switch_team(self_obj,TEAM_HOOVER_DAM)
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_STORE_OWNER);
   add_timer_event(self_obj,game_ticks(1),1);
   Ailis_Ptr = self_obj;
end

procedure map_update_p_proc begin
   Ailis_Ptr = self_obj;
end

/* Every heartbeat that the critter gets, this procedure will be called. Anything from
   Movement to attacking the player on sight can be placed in here.*/
procedure critter_p_proc begin

/* If the critter is mad at the player for any reason, it will attack and remember to attack
   the player should the game be saved and loaded repeatedly. Additionally, if any special
   actions need to be taken by the critter based on previous combat, the critter will remember
   this as well. */

   if (map_var(MVAR_TAMPERED_CC_DOOR) == 1) then begin
      switch_team(self_obj,TEAM_CRIMSON_CARAVAN)
      add_timer_event(self_obj,game_ticks(3),3);
   end

   if ((global_var(GVAR_ENEMY_HOOVER_DAM) == 1) and self_can_see_dude) then begin
       self_attack_dude;
   end

   if ((local_var(LVAR_Hostile) == 2) and self_can_see_dude) then begin
       set_local_var(LVAR_Hostile,1);
       self_attack_dude;
   end

end

/* Whenever the critter takes damage of any type, this procedure will be called. Things
   like setting ENEMY_ and LVAR_Personal_Enemy can be set here. */
procedure damage_p_proc begin

/* If the player causes damage to this critter, then he will instantly consider the player
   his personal enemy. In Critter_Proc or through dialog, actions will be taken against
   the player for his evil acts. */
   if (obj_in_party(source_obj)) then begin
       set_local_var(LVAR_Personal_Enemy,1);

       if (global_var(GVAR_CC_ARREST) != CC_ARREST_IN_PROGRESS) then begin
         set_global_var(GVAR_ENEMY_HOOVER_DAM,1);
      end
   end

end

/* Any time that the player is caught stealing from this critter, Pickup_proc will be called.
   In here, various things can happen. The most common response is instant hostility which
   will be remembered. */
procedure pickup_p_proc begin
   if (source_obj == dude_obj) then begin
       set_local_var(LVAR_Hostile,2);
   end
end

/* The dialog system is setup and prepares the player to talk to this NPC. Where To Go
   written by designers are placed in here. Additionally, Reactions are generated and
   stored which affects player interactions. */
procedure talk_p_proc begin

   Evil_Critter:=1;
   Slavery_Tolerant:=SLAVE_PROUD;
   Karma_Perception:=KARMA_PERCEPTION1;

   CheckKarma;

   GetReaction;

   if (local_var(LVAR_InJail) == 1) then
      display_mstr(122);
   else if(
      (global_var(GVAR_QUEST_EXTORT_AILIS) == QUEST_COMPLETED) and
      (local_var(LVAR_GoAwayTime) > 0) and
      ((game_time - local_var(LVAR_GoAwayTime)) / ONE_GAME_HOUR >= 24)
      ) then begin
      if (local_var(LVAR_Recreate_Ledger_Once) == 0) then begin
         give_pid_qty(self_obj, PID_WRITTEN_LEDGER, 1)
         set_local_var(LVAR_Recreate_Ledger_Once, 1);
      end
      switch_team(self_obj,TEAM_CRIMSON_CARAVAN)
      floater_bad(980);
      call Node998;
   end else begin

      call set_idiot_savant_int;

      call CalculateCaravanRunSuccessRate(CURRENT_CARAVAN);

      if ((global_var(CURRENT_CARAVAN) == CARAVAN_ABANDONED) and (local_var(LVAR_No_More_Caravans) == 0) and (global_var(GVAR_CC_ARREST) != CC_ARREST_IN_PROGRESS)) then
         call Node001;
      else if ((global_var(CURRENT_CARAVAN) == CARAVAN_ABANDONED) and (local_var(LVAR_No_More_Caravans) == 1) and (global_var(GVAR_CC_ARREST) != CC_ARREST_IN_PROGRESS)) then
         call Node001a;
      else begin
         start_gdialog(NAME,self_obj,4,HEAD_AILIS_MCLAFFERTY,-1);
         gSay_Start;

         if (global_var(GVAR_CC_ARREST) == CC_ARREST_IN_PROGRESS) then
            call Node027;
         else if (is_3s_dead and (global_var(GVAR_3S_SHOWDOWN) == SHOWDOWN_DONE) and (global_var(GVAR_QUEST_FRAME_ENZO) == QUEST_DEFAULT_SOLVE) and (local_var(LVAR_Frame_Enzo_Talk) == 0)) then
            call Node041;
         else if (global_var(CURRENT_CARAVAN) == CARAVAN_THEFT) then
            call Node002;
         else if (global_var(CURRENT_CARAVAN) == CARAVAN_TOTAL_FAILURE) then
            call Node003;
         else if (global_var(CURRENT_CARAVAN) == CARAVAN_FAILURE) then
            call Node004;
         else if (global_var(CURRENT_CARAVAN) == CARAVAN_AVERAGE_SUCCESS) then
            call Node005;
         else if (global_var(CURRENT_CARAVAN) == CARAVAN_COMPLETE_SUCCESS) then
            call Node006;
         else if (dude_is_stupid) then
            call Node007;
         else if (local_var(LVAR_Herebefore) == 1) then
            call Node020;
         else
            call Node008;

         gSay_End;
         end_dialogue;
      end

      call restore_idiot_savant_int;

      if (Only_Once == 1) then begin
         load_map("hdgatest", 0);
      end
      else if ((caravan_status == CARAVAN_STATUS_ON_JOB) and (caravan_end == AREA_BLACKFOOT)) then begin
         mark_on_map(caravan_end)
         set_global_var(GVAR_CARAVAN_START_TIME, game_time);
         world_map;
      end
   end

end

/* This procedure gets called only on the death of this NPC. Special things like
   incrementing the death count for reputation purposes and Enemy Counters are placed
   in here. */
procedure destroy_p_proc begin

/* Increment the aligned critter counter*/
   inc_evil_critter
   set_ailis_dead;

   // Major died before Ailis, so set proper states
   if (major_dead and (global_var(GVAR_CC_ARREST) == CC_ARREST_IN_PROGRESS) and (cur_map_index == MAP_HOOVER_DAM_NORTH_GATE)) then begin
      set_global_var(GVAR_CC_ARREST, CC_ARREST_DONE);
      set_global_var(GVAR_QUEST_ARREST_AILIS, AILIS_KILLED);
   end

/* Set global_variable for Enemy status*/
end

/* Look_at_p_proc gets called any time that the player passes the cursor over any object.
   This should only hold the most cursory of glances for the player. */
procedure look_at_p_proc begin
   script_overrides;
   if (local_var(LVAR_Herebefore) == 0) then
       display_mstr(100);
   else
       display_mstr(101);
end

/* The player will see more indepth descriptions from this procedure. They are actively
   looking at the critter and want more information. Things like names can be added here
   if the critter is known to the player. */
procedure description_p_proc begin
   script_overrides;
   display_mstr(102);
end

/* Any time a skill is used on a critter this call is made. This can be to give examinations
   for things like Doctor skill or messages for various other skills. */
procedure use_skill_on_p_proc begin
   call injure_with_skill;
end

/* Should the Player ever cause the NPC too much discomfort that he desires to attack the player,
   this call will be made. Essentially, it stores the Hostile vaule so that the critter remembers
   he was once hostile towards the player.*/
procedure Node998 begin
   set_local_var(LVAR_Hostile,2);
end

/* Anytime that there is a need for an ending to dialog, this node is to be called. It will just
   exit from the dialog system without any reprisals from the NPC. */
procedure Node999 begin
   set_local_var(LVAR_Herebefore, 1);
end

procedure timed_event_p_proc begin
   if (fixed_param == 1) then begin
      if (self_can_speak and (global_var(GVAR_CC_ARREST) == CC_ARREST_IN_PROGRESS) and (local_var(LVAR_Node27Once) == 0)) then begin
         dialogue_system_enter;
      end else
         add_timer_event(self_obj,game_ticks(1),1);
  end
  else if (fixed_param == 2) then begin
   if (
      (global_var(GVAR_QUEST_ARREST_AILIS) == AILIS_ARRESTED) and
      not(obj_is_visible_flag(self_obj))
      ) then begin
         move_to(self_obj, 25107, self_elevation);
         critter_attempt_placement(self_obj, 25107, self_elevation);
         set_obj_visibility(self_obj, 0);
         set_local_var(LVAR_InJail, 1);
      end
  end
  else if (fixed_param == 3) then begin
      float_msg(self_obj, message_str(SCRIPT_GENERIC, random(3625, 3628)), FLOAT_COLOR_BAD);
      set_map_var(MVAR_TAMPERED_CC_DOOR, 2);
      call Node998;
  end

end

procedure Skill_Check_001_Barter begin
   variable roll_temp;
   roll_temp := roll_vs_skill(dude_obj, SKILL_BARTER, -99);
   if is_success(roll_temp) then
   begin
   call Node023;
   end
   else begin
   call Node024;
    end
   end

procedure Skill_Check_002_Speech begin
   variable roll_temp;
   roll_temp := roll_vs_skill(dude_obj, SKILL_CONVERSANT, -99);
   if is_success(roll_temp) then
   begin
   call Node030;
   end
   else begin
   call Node029;
      end
   end


