procedure Node041 begin

   set_local_var(LVAR_Frame_Enzo_Talk, 1);

   Reply(1190);
   NOption(1191,Node999,4);
end

procedure Node042
begin
Reply(1220);
NOption(1221,Node999,4);
if (dude_caps >= 10000) then begin
   NOption(1222,Node043,4);
end
end

procedure Node043
begin
set_global_var(GVAR_CIPHER_FOOD, CIPHER_FOOD_HOOVER_DAM_CARAVANS);
item_caps_adjust(dude_obj, -10000);
Reply(1250);
NOption(1251,Node999,4);
end

procedure ResistArrest begin
   switch_team(self_obj, TEAM_CRIMSON_CARAVAN)
   call Node998;
end

procedure JailTime begin
   set_global_var(GVAR_CC_ARREST, CC_ARREST_DONE);
   set_global_var(GVAR_QUEST_ARREST_AILIS, AILIS_ARRESTED);
   set_local_var(LVAR_GoAwayTime, 0);
   move_obj_inven_to_obj(self_obj, tile_contains_pid_obj(24912, 0, PID_FOOTLOCKER_RUSTY_LEFT));
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   add_timer_event(self_obj,game_ticks(1),2);
   fadein(1);
   call Node999;
end

