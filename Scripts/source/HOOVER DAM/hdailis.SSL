procedure Node018a begin
   variable Caravan_Carts;
   variable Caravan_Guards;

   Caravan_Carts := random(1, 2);
   Caravan_Guards := random(1, 4);
   Caravan_Guards := (Caravan_Guards - party_size);
   if (Caravan_Guards < 1) then
      Caravan_Guards := 1;

   set_global_var(CURRENT_CARAVAN, CARAVAN_ON_CARAVAN);
   set_caravan_status(CARAVAN_STATUS_ON_JOB);
   set_global_var(GVAR_CARAVAN_EXPECTED_TIME, CARAVAN_RUN_DAYS_HOOVER_DAM_BLACKFOOT);

   set_global_var(GVAR_CARAVAN_START,AREA_HOOVER_DAM);
   set_global_var(GVAR_CARAVAN_END,AREA_BLACKFOOT);

   if (not(dude_is_caravan_master)) then
      set_caravan_masters(1);
   set_caravan_guards(Caravan_Guards);
   set_caravan_carts(Caravan_Carts);
   set_caravan_brahmin(2 * Caravan_Carts);
   set_caravan_drivers(Caravan_Carts);
end

