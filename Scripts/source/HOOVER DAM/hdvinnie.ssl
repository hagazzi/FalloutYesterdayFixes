procedure Cutscene begin
   MyTile := self_tile;

   fadeout(1);

   move_to(self_obj, 10321, self_elevation);
   move_to(dude_obj, 10121, dude_elevation);
   critter_attempt_placement(self_obj, 10321, self_elevation);
   critter_attempt_placement(dude_obj, 10121, dude_elevation);

   reg_anim_clear(self_obj);
   reg_anim_begin();
   anim(self_obj, ANIMATE_ROTATION, 5);
   reg_anim_end();

   reg_anim_clear(dude_obj);
   reg_anim_begin();
   anim(dude_obj, ANIMATE_ROTATION, 2);
   reg_anim_end();

   game_time_advance_hour(2300);
   tile_set_center(dude_tile);

   Ailis = create_object_sid(PID_AILIS_MCLAFFERTY, 8511, dude_elevation, -1);
   reg_anim_clear(Ailis);
   reg_anim_begin();
   anim(Ailis, ANIMATE_ROTATION, 3);
   reg_anim_end();

   fadein(1);

   call Node999;

   add_timer_event(self_obj, game_ticks(1), 1);
   add_timer_event(self_obj, game_ticks(7), 2);
   add_timer_event(self_obj, game_ticks(13), 3);
   add_timer_event(self_obj, game_ticks(19), 4);
   add_timer_event(self_obj, game_ticks(25), 5);
   add_timer_event(self_obj, game_ticks(31), 6);
   add_timer_event(self_obj, game_ticks(37), 7);
   add_timer_event(self_obj, game_ticks(43), 8);
   add_timer_event(self_obj, game_ticks(49), 9);

   party_no_follow_on;

   game_ui_disable;

end

procedure BeatDude begin
   variable sfxv, sfxd, animd;

   if (Beatings == 3) then
      animd = ANIM_fall_back;
   else
      animd = ANIM_hit_from_front;

   reg_anim_clear(self_obj);
   reg_anim_begin();
   reg_anim_animate(self_obj, ANIM_throw_punch, -1);
   reg_anim_end();
   sfxv := sfx_build_char_name(self_obj, ANIM_throw_punch, snd_contact);

   reg_anim_clear(dude_obj);
   reg_anim_begin();
   reg_anim_animate(dude_obj,animd,-1);
   sfxd := sfx_build_char_name(dude_obj, animd, snd_contact);
   reg_anim_play_sfx(dude_obj, sfxv, 1);
   reg_anim_play_sfx(dude_obj, sfxd, 1);
   reg_anim_end();

   Beatings += 1;
end

