procedure critter_p_proc begin
    if(map_var(MVAR_BOUNTY_HUNTERS_GONE) == 1 or global_var(GVAR_FA_LEGION_GONE) == 2) then begin
        set_obj_visibility(self_obj, 1);
        destroy_object(self_obj);
     end
end
