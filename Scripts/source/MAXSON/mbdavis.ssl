procedure Mich_0
begin
Reply(200);
NOption(201,Mich_1a_1,1);
// NOTE: Michael needs to have spoken node Mich_1a_2a, OR, for dumb players, node Mich_1a_D2, where he introduces himself by name AND the variable Mich_Rude must be 2 or less.
NOption(202,Mich_1b_1,1);
// NOTE: Michael needs to have spoken node Mich_1a_2a, where he introduces himself by name AND the variable Mich_Rude must be 3 or greater. If Mich_Rude>=10 OR Mich_Guilt_Trip>1, then Michael will not speak to the PC at all, but will float hostile text.
NOption(203,Mich_1_Ba_1,1);
end

// Node Mich_1_Ba_1
//
// Notes:
//
// Because the PC has been rude to Michael previously, the Priest will not use his rad-away freely on him. (See Mich_2_2). Michael's justification for this is that the PC is a 'bad sort', and the drugs should be used on someone more deserving. \

procedure Mich_1_Ba_1
begin
if (dude_is_male) then Reply(230); else
if (dude_is_female) then Reply(231);
NOption(232,Mich_9,4);
// NOTE: This option only appears IF the PC has a shovel AND Mich_Shovel>0 AND Mich_Cemetary_Bones=0. Also, the variable Mich_Alex_Force must be greater than 0, OR Mich_G_Counter_Return must be greater than 0 AND Mich_Site_Bones_Return must be greater than 2.
NOption(233,Mich_1b_2a,4);
// NOTE: This node is only visible if the variable Mich_Alex_Force>0 AND Mich_Shovel<1.
NOption(234,Mich_7_1,4);
if (dude_is_male) then
NOption(235,Mich_1_Ba_2,4);
if (dude_is_female) then
NOption(236,Mich_1_Ba_2,4);
NOption(237,Node999,4);
end

