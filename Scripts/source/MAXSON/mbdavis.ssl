// The Mich_6_* path is where the PC brings the bones and/or geiger counter from the Sandover expedition site to show to Michael so that the Priest will let the PC dig up the bones at Sandover's cemetary.

procedure Mich_6_1
begin
if (dude_is_male) then Reply(3140); else
if (dude_is_female) then Reply(3141);
// NOTE: This node only appears if the PC has found the geiger counter marked with the initials M.S. AND Mich_G_Counter_Return=0.
NOption(3142,Mich_6_2a,4);
// NOTE: This node only appears if the PC has found at least one set of the Explorers' bones at the high-rad expedition site. Perhaps we need a different variable for each set of bones at the expedition site, so the script knows which set of bones has been checked by Michael or not.
NOption(3143,Mich_6_2b,4);
NOption(3144,Mich_5_7_4a_2a,4);
NOption(3145,Mich_9,4);
end

// Node Mich_6_2a
