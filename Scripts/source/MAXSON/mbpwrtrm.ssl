procedure Node001
begin
Reply(200);
NOption(201,Node002,1);
NOption(202,Node999,1);
end

procedure Node002
begin
Reply(230);
if(obj_is_carrying_obj_pid(self_obj,PID_MB_LIBRARY_KEYCARD)>0)  then
NOption(231,Node003,1);
NOption(202,Node999,1);
end

procedure Node003
begin
Reply(260);
NOption(261,Node004,1);
end

procedure Node004
begin
   variable sfx;

   fadeout(1);
   sfx := play_sfall_sound("data\\sound\\SFX\\pipes.wav", 0);

   fadein(1);
   set_global_var(GVAR_BROTHERHOOD_DEAD, 1);
   inc_bos_rep(-50);

Reply(290);
if(obj_is_carrying_obj_pid(self_obj,PID_MB_LIBRARY_KEYCARD)>0)  then
NOption(291,Node999,1);
NOption(292,Node999_klaxon,1);
end

procedure Node005
begin
Reply(320);
NOption(321,Node999,1);
end

procedure Node999_klaxon
begin
   set_global_var(GVAR_BROTHERHOOD_KLAXON, 1);
   set_global_var(GVAR_WELCOME_BOS, -1);
call Node999;
end


