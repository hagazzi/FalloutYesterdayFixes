// Notes:
//
// Players that convince Blackjack to surrender can do so by either persuasion or calling out his bluff of the fake minigun. For either pathway, the following will occur when players guide blackjack out:

procedure Node021
begin


display_mstr(151);
give_xp(300);

Reply(830);
NOption(831,Node022,4);
// NOTE: Player knows about fake minigun
if (map_var(MVAR_Knows_Blackjack_Fake_Minigun) == 1) then begin
   NOption(832,Node023,4);
end
NOption(833,Node024,4);
NOption(834,Node025,4);
end

// Node Node022
//
// Notes:
//
// Teleport to Fort Abandon

procedure Node022
begin
Reply(860);
NOption(861,travel_to_fa,4);
end

procedure travel_to_fa begin
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   variable Blackjack = tile_contains_pid_obj(25310, self_elevation, PID_BLACKJACK);
   if (Blackjack != 0) then begin
      set_obj_visibility(Blackjack, 1);
   end
   set_global_var(GVAR_MEET_ALEXANDRA_AT_FA, 1);
   set_global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF, QUEST_COMPLETED);
   fadein(1);
   call Node999;
end

