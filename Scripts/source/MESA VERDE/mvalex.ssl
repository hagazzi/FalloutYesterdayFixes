procedure Node092 begin
   Reply(2960);
   NOption(2961,Node093,4);
   NOption(2962,Node094,4);
   NOption(2963,Node999,4);
end

procedure Node093 begin
   if (cur_town == AREA_MESA_VERDE) or (cur_town == AREA_MESA_VERDE_SHADOW_MAPS) then begin
      Reply(2991);
   end
   else if (cur_town == AREA_HOOVER_DAM) or (cur_town == AREA_HOOVER_DAM_SHADOW_MAPS) then begin
      Reply(2992);
   end
   else if (cur_town == AREA_FORT_ABANDON) then begin
      Reply(2993);
   end
   // TODO before after sacking
   else if (cur_town == AREA_JERICHO) then begin
      Reply(2994);
   end
   // TODO before after sacking
   else if (cur_town == AREA_NEW_CANAAN) then begin
      Reply(2995);
   end
   else if (cur_town == AREA_DOGTOWN) then begin
      Reply(2996);
   end
   else if (cur_town == AREA_THE_RESERVATION) then begin
      Reply(2997);
   end
   else if (cur_town == AREA_BLACKFOOT) then begin
      Reply(2998);
   end
   else begin
      Reply(2990);
   end

   NOption(2964,Node999,4);
   NOption(2966,Node999,-3);
end


procedure Node094 begin
   item_caps_adjust(dude_obj, 250);
   Reply(2320);
   NOption(1133,join_check,4);
   NOption(2964,Node999,4);
end

