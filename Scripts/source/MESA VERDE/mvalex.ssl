/*******************************************************************
*                           PROCEDURES                             *
*******************************************************************/
procedure start begin
end

procedure map_enter_p_proc begin
   /*  This procedure will get called each time that the map is first entered. It will
       set up the Team number and AI packet for this critter. This will override the
       default from the prototype, and needs to be set in scripts. */

   //party_member_map_enter;
   if not(Alexandra_In_Party) then begin
      critter_add_trait(self_obj, TRAIT_OBJECT, OBJECT_TEAM_NUM,TEAM_ALEXANDRA);
   end

   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_PARTY_ALEXANDRA_CUSTOM);

   call critter_setup_footsteps_map_enter(self_obj, WALKING_TICKS_DEFAULT, RUNNING_TICKS_DEFAULT);

   add_timer_event(self_obj,game_ticks(1),0);

   // Can't spawn here, Blackjack's dead
   if(
      (global_var(GVAR_ALEXANDRA_DEAD) == 1) or
      (
         (
            (global_var(GVAR_BLACKJACK_DEAD) == 1) or
            (global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF) == ALEXANDRA_BLACKJACK_TRICKED) or
            (global_var(GVAR_BLACKJACK_RESOLUTION) == BLACKJACK_RESOLUTION_ESCAPED)
         ) and
         (cur_map_index == MAP_MESA_VERDE_CANYON_SOUTH_CAVE)
         )
   ) then begin
      set_obj_visibility(self_obj, 1);
      destroy_object(self_obj);
   end

   if (
      (cur_map_index == MAP_FORT_ABANDON_COURTYARD) and
      (global_var(GVAR_ALEXANDRA_DEAD) == 0) and
      not(Alexandra_In_Party)
   ) then begin
      if (global_var(GVAR_MEET_ALEXANDRA_AT_FA) == 1)
      then begin
         set_global_var(GVAR_MEET_ALEXANDRA_AT_FA, 2);
         if (not(obj_is_visible_flag(self_obj))) then begin
            set_obj_visibility(self_obj, 0);
         end
      end
      else if (
         (global_var(GVAR_MEET_ALEXANDRA_AT_FA) == 0) and
         obj_is_visible_flag(self_obj)
      ) then begin
         set_obj_visibility(self_obj, 1);
      end
   end
end

procedure timed_event_p_proc begin
   call critter_setup_footsteps_timed_event(self_obj, WALKING_TICKS_DEFAULT, RUNNING_TICKS_DEFAULT, SFX_FOOTSTEP_SOFT_SHOE);
end

/* Every heartbeat that the critter gets, this procedure will be called. Anything from
   Movement to attacking the player on sight can be placed in here.*/
procedure critter_p_proc begin

/* If the critter is mad at the player for any reason, it will attack and remember to attack
   the player should the game be saved and loaded repeatedly. Additionally, if any special
   actions need to be taken by the critter based on previous combat, the critter will remember
   this as well. */

   if (hostile) and (self_can_see_dude) then begin
      self_attack_dude; //Macro made by Tom to keep the critter fleeing.
   end

   /* This next script moves the new party member to follow the player after they've joined and
      when entering new maps. */
   if (Alexandra_In_Party) then begin

      if (check_general_rep <= KARMA_SWORD_OF_DESPAIR) then begin
         call Abandon_Party;
         debug_msg("Alexandra Bad Player Rep");
         if (dude_is_male) then begin
            floater_bad_rand(5361, 5365);
         end else begin
            floater_bad_rand(5360, 5364);
         end
      end
      else if (has_rep_childkiller) then begin
         call Abandon_Party;
         debug_msg("Alexandra: Child Killer");
         floater_bad_rand(5360, 5365);
      end
      else if (has_rep_berserker) then begin
         call Abandon_Party;
         debug_msg("Alexandra: Berserker");
         floater_bad_rand(5360, 5365);
      end
      else if (party_is_waiting == false) then begin
         party_member_follow_dude
      end
   end
end

/* Whenever the critter takes damage of any type, this procedure will be called. Things
   like setting ENEMY_ and LVAR_Personal_Enemy can be set here. */
procedure damage_p_proc begin

/* If the player causes damage to this critter, then he will instantly consider the player
   his personal enemy. In Critter_Proc or through dialog, actions will be taken against
   the player for his evil acts. */
   if (obj_in_party(source_obj)) then begin
      set_personal_enemy;
   end
end

procedure pickup_p_proc begin
   /* Any time that the player is caught stealing from this critter, Pickup_proc will be called.
      In here, various things can happen. The most common response is instant hostility which
      will be remembered. */

   if (source_obj == dude_obj) then begin
      set_hostile;
   end

end

procedure talk_p_proc begin

/* The dialog system is setup and prepares the player to talk to this NPC. Where To Go
   written by designers are placed in here. Additionally, Reactions are generated and
   stored which affects player interactions. */
   Evil_Critter:=0;
   Slavery_Tolerant:=SLAVE_TOLERANT;
   Karma_Perception:=KARMA_PERCEPTION1;

   CheckKarma;

   GetReaction;
   ReactToLevel;
   find_party_background;
   call set_idiot_savant_int;

   start_gdialog(NAME,self_obj,4,HEAD_ALEXANDRA,PartyMemberBackground);
   gSay_Start;

   if ((Alexandra_Ptr != 0) or (party_is_waiting)) then begin
      call Node1000;
   end
   else if (has_rep_childkiller or (check_general_rep <= KARMA_SWORD_OF_DESPAIR)) then begin
      call Node031;
   end
   else if (global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF) == ALEXANDRA_BLACKJACK_TRICKED) then begin
      call Node021;
   end
   else if (global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF) == ALEXANDRA_BLACKJACK_CAVE_COLLAPSED) then begin
      call Node026;
   end
   else if (global_var(GVAR_BLACKJACK_RESOLUTION) == BLACKJACK_RESOLUTION_ESCAPED) then begin
      call Node030;
   end
   else if (global_var(GVAR_MEET_ALEXANDRA_AT_FA) == 2) then begin
      call Node092;
   end
   else if (global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF) == QUEST_ACCEPTED) then begin
      call Node012;
   end
   else if (dude_is_stupid) then begin
      call Node017;
   end
   else begin
      call Node001;
   end

   gSay_End;
   end_dialogue;
   call restore_idiot_savant_int;
end

procedure destroy_p_proc begin
/* This procedure gets called only on the death of this NPC. Special things like
   incrementing the death count for reputation purposes and Enemy Counters are placed
   in here. */

/* Increment the aligned critter counter*/
   inc_neutral_critter

/* Set global_variable for Enemy status*/
   set_global_var(GVAR_ALEXANDRA_DEAD, 1);
   set_global_var(GVAR_ENDGAME_MOVIE_ALEX, 0);
end

/* Look_at_p_proc gets called any time that the player passes the cursor over any object.
   This should only hold the most cursory of glances for the player. */
procedure look_at_p_proc begin
   script_overrides;
   if not(herebefore) then begin
      set_herebefore;
      display_mstr(100);
   end else begin
      display_mstr(101);
   end
end

/* The player will see more indepth descriptions from this procedure. They are actively
   looking at the critter and want more information. Things like names can be added here
   if the critter is known to the player. */
procedure description_p_proc begin

   script_overrides;
   display_mstr(102);
end

/* Any time a skill is used on a critter this call is made. This can be to give examinations
      for things like Doctor skill or messages for various other skills. */
procedure use_skill_on_p_proc begin
   call injure_with_skill;
end

procedure map_exit_p_proc begin
   if (
      (global_var(GVAR_MEET_ALEXANDRA_AT_FA) == 1) and
      not(obj_is_visible_flag(self_obj)) and
      not(Alexandra_In_Party)
      ) then begin
      destroy_object(self_obj);
   end
end

procedure push_p_proc begin
   floater_rand(5000, 5002);                               // Random Float responses for being pushed by player
end

/* This node checks for stuff before allowing NPC to join party.
   You can add other conditions for joining here. */
procedure join_check begin

   if (dude_charisma <= 1) then begin
      floater_bad(5030);                                    // Response if player has 1 Charisma or less
   end
   else begin
      if (dude_at_max_party_size) then begin
         Reply(5031);                                           // This line is for when the character does NOT join the player's party       (because too many followers)
         NOption(441,Node999,1);                            // This NOption message is Normal Int player response to NOT joining party    (because too many followers)
      end
      else if (town_rep_is_hated) then begin
         Reply(5032);                                           // This line is for if the player is hated by the NPC's home town (hates player because TOWN_REPUTATION<=-15)
         BOption(441, Node998, 1);                          // This line is Normal Int response to being hated by the NPC's home town  (default points to combat Node998)
      end
      else if (map_is_random_encounter) then begin          // She joins in the bounty hunter encounter
         Reply(1190);
         NOption(1191,Join_Party,4);
      end
      else begin
         Reply(470);                                           // This line is for when the character agrees to Join the player's party
         NOption(mstr(473)+" "+mstr(471)+dude_name+mstr(472),Join_Party,4);
         NOption(mstr(473)+" "+mstr(474),Join_Party,4);
      end
   end
end

/* Should the Player ever cause the NPC too much discomfort that he desires to attack the player,
   this call will be made. Essentially, it stores the Hostile vaule so that the critter remembers
   he was once hostile towards the player.*/
procedure Node998 begin
   set_hostile;
end

/* Anytime that there is a need for an ending to dialog, this node is to be called. It will just
   exit from the dialog system without any reprisals from the NPC. */
procedure Node999 begin
   set_herebefore;
   set_global_var(GVAR_KNOW_ALEXANDRA, 1);
end

/* This node places the NPC in the player's party.
   Call this node any time you want an action from the player to result in the NPC joining their party. */
procedure Join_Party begin
   Alexandra_joins_party;
   set_local_var(LVAR_Joined_Player,1);
   floater_good(2960);
end

procedure Abandon_Party begin
   //leave party
   if (self_visible) then begin
      set_self_abandon_party;
   end

end

   /* Node1000 and on are default dialogue nodes for a generic NPC joining the player's party. */

procedure Node1000 begin
   Reply(random(5060, 5063));                                        // This reply is when the NPC is in your party and you talk to them
   NOption(2961,Node093,4);
   NOption(2965,Node093,-3);
   party_member_default_options;
end

procedure Node1001 begin
   // heal yourself
   obj_heal(self_obj)
   if (party_healed_max) then begin
      Reply(random(5090,5093));                                     // This reply is when your party member is healed to max
   end
   else if (party_healed_good) then begin
     Reply(random(5094,5096));                                      // This reply message is for when the NPC is Barely Hurt (90% health or above)
   end
   else if (party_healed_hurt) then begin
      Reply(random(5097,5099));                                     // This reply message is for when the NPC is Wounded (70%-90% health?)
   end
   else begin
      Reply(random(5100,5102));                                     // This reply message is for Failures
   end
   party_member_default_options;
end

procedure Node1002 begin
   // wait here
   set_party_waiting;
   Reply(random(5120,5123));                            // These reply messages are in response to wait request
   party_member_default_options;
end

procedure Node1003 begin
   // put your weapon away
   inven_unwield(self_obj);
   Reply(random(5150,5152));                                        // Response to removing weapon
   party_member_default_options;
end

procedure Node1004 begin
   // follow close
   set_follow_close;
   Reply(5180);                            // Random responses for distance change
   party_member_default_options;
end

procedure Node1005 begin
   // follow medium
   set_follow_medium;
   Reply(5182);                            // Random responses for distance change
   party_member_default_options;
end

procedure Node1006 begin
   // follow far
