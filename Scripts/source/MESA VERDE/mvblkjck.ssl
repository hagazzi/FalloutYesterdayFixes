procedure Node012
begin
Reply(530);
if (
   (global_var(GVAR_ALEXANDRA_DEAD) == 1) or
   (global_var(GVAR_BLACKJACK_RESOLUTION) == BLACKJACK_RESOLUTION_PAID_OFF) or
   (global_var(GVAR_BLACKJACK_RESOLUTION) == BLACKJACK_RESOLUTION_ALEXANDRA_GAVE_UP) or
   (dude_skill(SKILL_CONVERSANT) >= 50)
) then begin
   if (dude_skill(SKILL_CONVERSANT) >= 50) then begin
      NOption(531,BlackjackTricked,4);
   end
   else begin
      NOption(531,Node013,4);
   end
end
NOption(532,Node999,4);
