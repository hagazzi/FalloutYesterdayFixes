   NOption(534,Node016,4);
end
end

procedure BlackjackTricked begin
   set_global_var(GVAR_BLACKJACK_RESOLUTION, BLACKJACK_RESOLUTION_TRICKED);
   set_global_var(GVAR_QUEST_ALEXANDRA_BLACKJACK_STANDOFF, ALEXANDRA_BLACKJACK_TRICKED);
   call Node013;
end

