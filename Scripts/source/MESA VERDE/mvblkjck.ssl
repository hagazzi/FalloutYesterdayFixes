//xxxxxxxxxxxxxxxxxxxx

procedure LeaveCave begin
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   fadein(1);
   set_global_var(GVAR_BLACKJACK_GONE, 1);
   call Node999;
end

procedure FleeOutside begin
   variable animation = ANIMATE_RUN;
   if (map_var(MVAR_Knows_Blackjack_Fake_Minigun) == 1) then begin
      animation = ANIMATE_WALK;
   end

   animate_move_obj_to_tile(self_obj, 20138, (animation bwor ANIMATE_INTERRUPT));
end

procedure FleeOutsideDialog begin
   set_local_var(LVAR_FleeOutside, 1);
   call Node999;
end
