/*
Educator

    npc_engine_level_up
inc_npc_level


Available to all.

You are a natural teacher. As you learn skill training, you can teach your followers the previous training step. So as an Expert, you can teach your followers as Apprentices, if they qualify. However, since you spend extra time with each follower, you cannot have as many as usual (-1 to maximum followers).

Max # of Followers -1 / Followers improve faster


Escaped Lunatic
Available to humans.

You have escaped from an insane asylum and stowed away aboard the IFS Zephyr. You are extremely resistant to damage (+25% to normal, fire, electrical, and poison resistance) but you have no money, you have stolen some cheap clothing, and most people are frightened or repulsed by you (-25 reaction).

Resist Damage +25 / Fire Resistance +25 / Electrical Resistance +25 / Poison Resistance +25 / Reaction -25 / 0 Gold/ Rustic Finery/Dress


Extreme Personality
Available to all.

You possess an extreme personality. People react more strongly to your presence, and tend to grow to either love or hate you.

Bad Reaction Adjustment -30 / Good Reaction Adjustment +30






Sold Your Soul
Available to all.

You have made a pact with a demon. In exchange for more magickal power, you have dedicated your life to the pursuit of evil. You gain 20% to Magickal Aptitude, but suffer -20 reaction from others and a -20 alignment (and your alignment can NEVER go higher).

Magick Points +4 / Reaction -20 / Alignment -200 / Alignment max -200



Technophobia
Available to humans, half-elves, half-orcs, and halflings.

You were raised on a potato farm in the rustic backwaters of a distant land. You worked hard, gaining a bonus to Strength (+1) and Constitution (+1), but you never experienced any technology of any kind. Subsequently, you are afraid of technological items and cannot bring yourself to even pick one up.

ST +1 / CN +1 / Cannot add any tech items to your inventory








*/

end

procedure apply_traits begin

    if (has_fake_trait(TRAIT_color_blind)) then begin
        activate_shader(load_shader("colorblind.fx"));
    end

    if (has_fake_trait(TRAIT_computer_ops)) then begin
        critter_mod_skill(dude_obj, SKILL_SCIENCE, 30);
        critter_mod_skill(dude_obj, SKILL_REPAIR, -15);
        critter_mod_skill(dude_obj, SKILL_ENERGY_WEAPONS, -15);
    end

    if (has_fake_trait(TRAIT_danger_sense)) then begin
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 1);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) + 1);
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) - 2);
    end

    if (has_fake_trait(TRAIT_domesticated)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 2);
        critter_mod_skill(dude_obj, SKILL_UNARMED_COMBAT, -50);
    end

    if (has_fake_trait(TRAIT_electronic_ops)) then begin
        critter_mod_skill(dude_obj, SKILL_SCIENCE, -30);
        critter_mod_skill(dude_obj, SKILL_REPAIR, 15);
        critter_mod_skill(dude_obj, SKILL_ENERGY_WEAPONS, 15);
    end

    if (has_fake_trait(TRAIT_feral_kid)) then begin
        critter_mod_skill(dude_obj, SKILL_OUTDOORSMAN, 20);
        critter_mod_skill(dude_obj, SKILL_THROWING, 20);
    end

    if (has_fake_trait(TRAIT_ham_fisted)) then begin
        set_pc_extra_stat(STAT_melee_dmg, get_pc_extra_stat(STAT_melee_dmg) + 2);
        critter_mod_skill(dude_obj, SKILL_UNARMED_COMBAT, 30);
        critter_mod_skill(dude_obj, SKILL_FIRST_AID, -10);
        critter_mod_skill(dude_obj, SKILL_DOCTOR, -10);
        critter_mod_skill(dude_obj, SKILL_SCIENCE, -10);
        critter_mod_skill(dude_obj, SKILL_TRAPS, -10);
        critter_mod_skill(dude_obj, SKILL_LOCKPICK, -10);
        critter_mod_skill(dude_obj, SKILL_REPAIR, -10);
    end

    // initial setup for Night Person, persistent code is in OBJ_DUDE.SSL
    if (has_fake_trait(TRAIT_night_person)) then begin
        variable mod_np_stats;
        variable mod_np;

        // 6PM - 6AM
        if (evening or night) then begin
            mod_np_stats := 1;
            mod_np := 2;
        end
        // 6AM - 6PM
        else if (morning or day) then begin
            mod_np_stats := -1;
            mod_np := 1;
        end

        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + mod_np_stats);
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + mod_np_stats);
        set_global_var(GVAR_NIGHT_PERSON, mod_np);
    end

    // initial setup for One In a Million, persistent code is in OBJ_DUDE.SSL
    if (has_fake_trait(TRAIT_one_in_a_million)) then begin
        variable luck := 1;
        variable r := random(1, 100);

        if (r > 50) then begin
            luck := 10;
        end

        call set_dude_attr(STAT_lu, luck);
        set_global_var(GVAR_ONE_IN_A_MILLION, get_day);
    end

    if (has_fake_trait(TRAIT_pacifist)) then begin
        set_critter_hit_chance_mod(dude_obj, 50, -50);
        critter_mod_skill(dude_obj, SKILL_CONVERSANT, 50);
        critter_mod_skill(dude_obj, SKILL_DOCTOR, 25);
        critter_mod_skill(dude_obj, SKILL_FIRST_AID, 50);
    end

      if (has_fake_trait(TRAIT_red_scare)) then begin
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 2);
        set_critter_hit_chance_mod(dude_obj, 90, -5);
    end

    if (has_fake_trait(TRAIT_tech_wizard)) then begin
        critter_mod_skill(dude_obj, SKILL_SCIENCE, 20);
        critter_mod_skill(dude_obj, SKILL_REPAIR, 20);
        critter_mod_skill(dude_obj, SKILL_LOCKPICK, 20);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) - 1);
    end

    if (
        (has_fake_trait(TRAIT_strong_will) and has_fake_trait(TRAIT_weak_will)) or
        (has_fake_trait(TRAIT_soothsayer) and has_fake_trait(TRAIT_big_liar))
    ) then begin
        set_global_var(GVAR_BIPOLAR, 1);
    end

    if (has_fake_trait(TRAIT_fear_of_the_dark)) then begin
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 2);
    end

    if (has_fake_trait(TRAIT_beastlord)) then begin
        display_msg(g_mstr(610));
    end

    if (has_fake_trait(TRAIT_raised_by_the_vipers)) then begin
        set_pc_extra_stat(STAT_poison_resist, get_pc_extra_stat(STAT_poison_resist) + 20);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 1);
    end

    if (has_fake_trait(TRAIT_fear_the_reaper)) then begin

        if(dude_is_super_mutant or dude_is_ghoul) then begin
            set_perk_freq(3 + has_trait(TRAIT_TRAIT, dude_obj, TRAIT_skilled));
        end else begin
            set_perk_freq(2 + has_trait(TRAIT_TRAIT, dude_obj, TRAIT_skilled));
        end

        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) - 5);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) - 5);
        call HealParty;

    end

    if (has_fake_trait(TRAIT_apprenticed_to_a_trader)) then begin
        critter_mod_skill(dude_obj, SKILL_BARTER, 60);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 1);
    end

    if (has_fake_trait(TRAIT_army_training)) then begin
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 20);
        critter_mod_skill(dude_obj, SKILL_MELEE, 20);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 1);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 1);
    end

    if (has_fake_trait(TRAIT_highwayman)) then begin
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 40);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 1);
    end

    if (has_fake_trait(TRAIT_tribal)) then begin
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 2);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) + 1);
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) - 1);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 2);
        critter_mod_skill(dude_obj, SKILL_MELEE, 20);
        critter_mod_skill(dude_obj, SKILL_OUTDOORSMAN, 40);
        critter_mod_skill(dude_obj, SKILL_BARTER, -40);
        critter_mod_skill(dude_obj, SKILL_CONVERSANT, -20);
    end

    if (has_fake_trait(TRAIT_bookworm)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 1);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) - 1);
    end

    if (has_fake_trait(TRAIT_beat_with_an_ugly_stick)) then begin
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 2);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) + 2);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 6);
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 20);
        critter_mod_skill(dude_obj, SKILL_MELEE, 20);
        critter_mod_skill(dude_obj, SKILL_UNARMED_COMBAT, 20);
        critter_mod_skill(dude_obj, SKILL_THROWING, 20);
    end

    if (has_fake_trait(TRAIT_bully)) then begin
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 1);
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) - 1);
    end

    if (has_fake_trait(TRAIT_idiot_savant)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 6);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) - 1);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) - 1);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 2);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 2);
        critter_mod_skill(dude_obj, SKILL_GAMBLING, 60);
    end

    if (has_fake_trait(TRAIT_hyperactive)) then begin
        set_pc_extra_stat(STAT_max_move_points, get_pc_extra_stat(STAT_max_move_points) + 1);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 1);
    end

    if (has_fake_trait(TRAIT_ladys_man)) then begin
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) + 6);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) - 2);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) - 2);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 2);
    end

    if (has_fake_trait(TRAIT_mad_scientist)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 2);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 2);
        set_pc_extra_stat(STAT_dmg_resist_electrical, get_pc_extra_stat(STAT_dmg_resist_electrical) + 20);
        set_pc_extra_stat(STAT_poison_resist, get_pc_extra_stat(STAT_poison_resist) + 20);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 2);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 2);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) - 3);
        critter_mod_skill(dude_obj, SKILL_DOCTOR, 20);
    end

    if (has_fake_trait(TRAIT_miracle_operation)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 3);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) +3);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 5);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) - 3);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) - 3);
        call set_dude_attr(STAT_en, get_pc_base_stat(STAT_en) - 5);
    end

    if (has_fake_trait(TRAIT_only_child)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) + 6);
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 4);
        critter_mod_skill(dude_obj, SKILL_BARTER, -40);
        critter_mod_skill(dude_obj, SKILL_CONVERSANT, -40);
    end

    if (has_fake_trait(TRAIT_raised_by_super_mutants)) then begin
        call set_dude_attr(STAT_ch, get_pc_base_stat(STAT_ch) - 6);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 2);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 2);
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 20);
        critter_mod_skill(dude_obj, SKILL_BIG_GUNS, 20);
        critter_mod_skill(dude_obj, SKILL_ENERGY_WEAPONS, 20);
        critter_mod_skill(dude_obj, SKILL_MELEE, 20);
        critter_mod_skill(dude_obj, SKILL_UNARMED_COMBAT, 20);
        critter_mod_skill(dude_obj, SKILL_THROWING, 20);
    end

    if (has_fake_trait(TRAIT_raised_in_the_pits)) then begin
        call set_dude_attr(STAT_iq, get_pc_base_stat(STAT_iq) - 6);
        call set_dude_attr(STAT_st, get_pc_base_stat(STAT_st) + 2);
        call set_dude_attr(STAT_ag, get_pc_base_stat(STAT_ag) + 2);
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 20);
        critter_mod_skill(dude_obj, SKILL_BIG_GUNS, 20);
