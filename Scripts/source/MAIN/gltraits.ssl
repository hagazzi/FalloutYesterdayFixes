procedure start begin

    variable mode;
    variable tt;
    tt := total_traits(dude_obj);

    if (game_loaded) then begin
        mode := get_sfall_global_int("fy_trt00");

        // disabled
        if(mode == -1) then begin
            return;
        end
        else if(mode == 0) then begin
            // disable
            if(dude_level > 1) then begin
                set_sfall_global("fy_trt00", -1);
                return;
            end
            if((2 - tt) > 0) then begin
                if((2 - tt) == 1) then begin
                    display_msg(g_mstr(611));
                end
                else if ((2 - tt) == 2) then begin
                    display_msg(g_mstr(612));
                end
                set_perk_owed(2 - tt);
                set_global_script_repeat(100);
                call setup_trait_dialog;
            end
        end
    end
    else begin
        // we can only pick new traits at level 1
        if(dude_level > 1) then begin
            clear_selectable_perks;
            set_perk_owed(get_perk_owed - (2 - tt));
            set_global_script_repeat(0);
            set_sfall_global("fy_trt00", 1);
            return;
        end
        // pick new one
        if(get_perk_owed > 0) then begin
            return;
        end
        // apply effects
        clear_selectable_perks;
        set_global_script_repeat(0);
        set_sfall_global("fy_trt00", 1);
        call apply_traits;
    end
end

// total traits picked
procedure total_traits(variable dude) begin
    variable total;
    total :=
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_fast_metabolism) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_bruiser) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_small_frame) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_one_hander) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_finesse) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_kamikaze) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_heavy_handed) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_fast_shot) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_bloody_mess) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_jinxed) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_good_natured) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_drug_addict) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_drug_resistant) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_sex_appeal) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_skilled) +
    has_trait(TRAIT_TRAIT, dude_obj, TRAIT_gifted);

    // cheater, bug?
    if (total < 0) then begin
        total := 0;
    end
    else if(total > 2 ) then begin
        total := 2;
    end

    return total;
end
