procedure perk_level_change begin

    if (
        (has_fake_perk(PERK_team_player) == 0) and
        (get_critter_stat(dude_obj, STAT_ch) >= 4) and
        (dude_level >= 3) and
        (true_party_size >= 1)
    ) then begin
        set_selectable_perk(PERK_team_player, 1, 108, mstr_perk(1220));
    end
    else begin
        set_selectable_perk(PERK_team_player, 0, 108, "");
    end

    if(
        (has_fake_perk(PERK_firewalker) < 2) and
        (get_critter_stat(dude_obj, STAT_en) >= 8)
    ) then begin
        set_selectable_perk(PERK_firewalker, 1, 215, mstr_perk(1221));
    end
    else begin
        set_selectable_perk(PERK_firewalker, 0, 215, "");
    end

    // TODO Double check this
    if(
        (has_fake_perk(PERK_mental_catalogue) == 0) and
        (get_critter_stat(dude_obj, STAT_pe) >= 4) and
        (has_skill(dude_obj, SKILL_SCIENCE) >= 10)
    ) then begin
        set_selectable_perk(PERK_mental_catalogue, 1, 216, mstr_perk(1222));
    end
    else begin
        set_selectable_perk(PERK_mental_catalogue, 0, 216, "");
    end

    if (
        (has_fake_perk(PERK_loner) == 0) and
        (get_critter_stat(dude_obj, STAT_ch) < 5) and
        (dude_level >= 4) and
        (has_skill(dude_obj, SKILL_OUTDOORSMAN) >= 40) and
        (true_party_size == 0)
    ) then begin
        set_selectable_perk(PERK_loner, 1, 217, mstr_perk(1223));
    end
    else begin
        set_selectable_perk(PERK_loner, 0, 217, "");
    end

    if ((has_fake_perk(PERK_hit_the_deck) == 0) and (get_critter_stat(dude_obj, STAT_ag) >= 6) and (dude_level >= 4)) then begin
        set_selectable_perk(PERK_hit_the_deck, 1, 219, mstr_perk(1224));
    end else begin
        set_selectable_perk(PERK_hit_the_deck, 0, 219, "");
    end

    if (
        (has_fake_perk(PERK_die_hard) == 0) and
        (get_critter_stat(dude_obj, STAT_en) >= 6) and
        (dude_level >= 2) and
        (has_skill(dude_obj, SKILL_FIRST_AID) >= 40)
    ) then begin
        set_selectable_perk(PERK_die_hard, 1, 218, mstr_perk(1225));
    end else begin
        set_selectable_perk(PERK_die_hard, 0, 218, "");
    end

    if (
        (has_fake_perk(PERK_hide_of_scars) == 0) and
        (get_critter_stat(dude_obj, STAT_en) >= 6) and
        (dude_level >= 10)
    ) then begin
        set_selectable_perk(PERK_hide_of_scars, 1, 220, mstr_perk(1226));
    end
    else begin
        set_selectable_perk(PERK_hide_of_scars, 0, 220, "");
    end

    if (
        (has_fake_perk(PERK_stat) < 2) and
        (get_critter_stat(dude_obj, STAT_ag) >= 6) and
        (dude_level >= 3) and
        (has_skill(dude_obj, SKILL_DOCTOR) >= 50) and
        (has_skill(dude_obj, SKILL_FIRST_AID) >= 75)
    ) then begin
        set_selectable_perk(PERK_stat, 1, 221, mstr_perk(1227));
    end
    else begin
        set_selectable_perk(PERK_stat, 0, 221, "");
    end

    if (
        (has_fake_perk(PERK_tunnel_rat) == 0) and
        (get_critter_stat(dude_obj, STAT_ag) >= 6) and
        (dude_level >= 8)
    ) then begin
        set_selectable_perk(PERK_tunnel_rat, 1, 222, mstr_perk(1228));
    end
    else begin
        set_selectable_perk(PERK_tunnel_rat, 0, 222, "");
    end

    if ((has_fake_perk(PERK_drunken_master) == 0) and (has_skill(dude_obj, SKILL_UNARMED_COMBAT) >= 60) and (dude_level >= 3)) then begin
        set_selectable_perk(PERK_drunken_master, 1, 223, mstr_perk(1229));
    end
    else begin
        set_selectable_perk(PERK_drunken_master, 0, 223, "");
    end

    if (
        (has_fake_perk(PERK_tough_hide) == 0) and
        (get_critter_stat(dude_obj, STAT_en) < 8) and
        (dude_level >= 12)
    ) then begin
        set_selectable_perk(PERK_tough_hide, 1, 227, mstr_perk(1230));
    end
    else begin
        set_selectable_perk(PERK_tough_hide, 0, 227, "");
    end

    if (
        (has_fake_perk(PERK_rad_child) == 0) and
        (get_critter_stat(dude_obj, STAT_en) >= 6) and
        (dude_level >= 3)
    ) then begin
        set_selectable_perk(PERK_rad_child, 1, 225, mstr_perk(1231));
    end
    else begin
        set_selectable_perk(PERK_rad_child, 0, 225, "");
    end

    if (
        (has_fake_perk(PERK_divine_favor) == 0) and
        (get_critter_stat(dude_obj, STAT_ch) >= 8) and
        (dude_level >= 14)
    ) then begin
        set_selectable_perk(PERK_divine_favor, 1, 226, mstr_perk(1232));
    end
    else begin
        set_selectable_perk(PERK_divine_favor, 0, 226, "");
    end

    if (
        (has_fake_perk(PERK_melee_master) == 0) and
        (get_critter_stat(dude_obj, STAT_st) >= 7) and
        (get_critter_stat(dude_obj, STAT_pe) >= 7) and
        (has_skill(dude_obj, SKILL_MELEE) >= 250)
    ) then begin
        set_selectable_perk(PERK_melee_master, 1, 224, mstr_perk(1233));
    end
    else begin
        set_selectable_perk(PERK_melee_master, 0, 224, "");
    end

    if (
        (has_fake_perk(PERK_esteemed_academic) == 0) and
        (get_critter_stat(dude_obj, STAT_iq) >= 9) and
        (has_skill(dude_obj, SKILL_SCIENCE) == 300) and
        (global_var(GVAR_SCIENCE_LAB) == 1)
    ) then begin
        set_selectable_perk(PERK_esteemed_academic, 1, 256, mstr_perk(1234));
    end
    else begin
        set_selectable_perk(PERK_esteemed_academic, 0, 256, "");
    end

    if (
        (has_fake_perk(PERK_advanced_research) == 0) and
        (get_critter_stat(dude_obj, STAT_iq) >= 7) and
        (has_skill(dude_obj, SKILL_SCIENCE) >= 50) and
        (global_var(GVAR_SCIENCE_LAB) == 1)
    ) then begin
        set_selectable_perk(PERK_advanced_research, 1, 257, mstr_perk(1235));
    end
    else begin
        set_selectable_perk(PERK_advanced_research, 0, 257, "");
    end

    if (
        (has_fake_perk(PERK_bonsai) == 0) and
        dude_is_ghoul and
        (has_skill(dude_obj, SKILL_OUTDOORSMAN) >= 50) and
        (has_skill(dude_obj, SKILL_SCIENCE) >= 40) and
        (dude_level >= 12)
    ) then begin
        set_selectable_perk(PERK_bonsai, 1, 281, mstr_perk(1236));
    end
    else begin
        set_selectable_perk(PERK_bonsai, 0, 281, "");
    end

    if (
        (has_fake_perk(PERK_stunt_man) == 0) and
        (get_critter_stat(dude_obj, STAT_st) >= 6) and
        (get_critter_stat(dude_obj, STAT_en) >= 6) and
        (get_critter_stat(dude_obj, STAT_ag) >= 6) and
        (dude_level >= 6)
    ) then begin
        set_selectable_perk(PERK_stunt_man, 1, 282, mstr_perk(1237));
    end
    else begin
        set_selectable_perk(PERK_stunt_man, 0, 282, "");
    end

    if (
        (has_fake_perk(PERK_cancerous_growth) == 0) and
        (get_critter_stat(dude_obj, STAT_st) <= 6) and
        dude_is_ghoul and
        (dude_level >= 6)
    ) then begin
        set_selectable_perk(PERK_cancerous_growth, 1, 283, mstr_perk(1238));
    end
    else begin
        set_selectable_perk(PERK_cancerous_growth, 0, 283, "");
    end

    if (
        (has_fake_perk(PERK_way_of_the_fruit) == 0) and
        (get_critter_stat(dude_obj, STAT_ch) >= 6) and
        (dude_level >= 6)
    ) then begin
        set_selectable_perk(PERK_way_of_the_fruit, 1, 284, mstr_perk(1239));
    end
    else begin
        set_selectable_perk(PERK_way_of_the_fruit, 0, 284, "");
    end

    if (
        (has_fake_perk(PERK_psychotic) == 0) and
        (get_critter_stat(dude_obj, STAT_en) >= 5) and
        dude_is_super_mutant and
        (dude_level >= 8)
    ) then begin
        set_selectable_perk(PERK_psychotic, 1, 285, mstr_perk(1240));
    end
    else begin
        set_selectable_perk(PERK_psychotic, 0, 285, "");
    end

    if (
        (has_fake_perk(PERK_deadly_accuracy_small_guns) == 0) and
        (get_critter_stat(dude_obj, STAT_ag) >= 5) and
        (has_skill(dude_obj, SKILL_SMALL_GUNS) >= 40)
    ) then begin
        set_selectable_perk(PERK_deadly_accuracy_small_guns, 1, 295, mstr_perk(1241));
    end
    else begin
        set_selectable_perk(PERK_deadly_accuracy_small_guns, 0, 295, "");
    end

    if (
        (has_fake_perk(PERK_deadly_accuracy_big_guns) == 0) and
        (get_critter_stat(dude_obj, STAT_ag) >= 5) and
        (has_skill(dude_obj, SKILL_BIG_GUNS) >= 40)
    ) then begin
        set_selectable_perk(PERK_deadly_accuracy_big_guns, 1, 295, mstr_perk(1242));
    end
    else begin
        set_selectable_perk(PERK_deadly_accuracy_big_guns, 0, 295, "");
    end

    if (
        (has_fake_perk(PERK_deadly_accuracy_energy_weapons) == 0) and
        (get_critter_stat(dude_obj, STAT_ag) >= 5) and
        (has_skill(dude_obj, SKILL_ENERGY_WEAPONS) >= 40)
    ) then begin
        set_selectable_perk(PERK_deadly_accuracy_energy_weapons, 1, 295, mstr_perk(1243));
    end
    else begin
        set_selectable_perk(PERK_deadly_accuracy_energy_weapons, 0, 295, "");
    end

    if (
        (has_fake_perk(PERK_deadly_accuracy_throwing) == 0) and
        (get_critter_stat(dude_obj, STAT_ag) >= 5) and
        (has_skill(dude_obj, SKILL_THROWING) >= 40)
    ) then begin
        set_selectable_perk(PERK_deadly_accuracy_throwing, 1, 295, mstr_perk(1244));
    end
    else begin
        set_selectable_perk(PERK_deadly_accuracy_throwing, 0, 295, "");
    end

    if (
        (has_fake_perk(PERK_pugilist) == 0) and
        (dude_level >= 5) and
        (has_skill(dude_obj, SKILL_UNARMED_COMBAT) >= 25)
    ) then begin
        set_selectable_perk(PERK_pugilist, 1, 296, mstr_perk(1245));
    end
    else begin
        set_selectable_perk(PERK_pugilist, 0, 296, "");
    end

    if (
        (has_fake_perk(PERK_grace_under_fire) == 0) and
        (dude_level >= 11) and
        (get_critter_stat(dude_obj, STAT_pe) <= 9)
    ) then begin
        set_selectable_perk(PERK_grace_under_fire, 1, 297, mstr_perk(1246));
    end
    else begin
        set_selectable_perk(PERK_grace_under_fire, 0, 297, "");
    end

    if (
        (has_fake_perk(PERK_observant) == 0) and
        (has_skill(dude_obj, SKILL_TRAPS) >= 30) and
        (get_critter_stat(dude_obj, STAT_pe) >= 5)
    ) then begin
        set_selectable_perk(PERK_observant, 1, 298, mstr_perk(1247));
    end
    else begin
        set_selectable_perk(PERK_observant, 0, 298, "");
    end

    if (
        (has_fake_perk(PERK_superior_senses) == 0) and
        (dude_level >= 14) and
        (get_critter_stat(dude_obj, STAT_pe) >= 5)
    ) then begin
        set_selectable_perk(PERK_superior_senses, 1, 299, mstr_perk(1248));
    end
    else begin
        set_selectable_perk(PERK_superior_senses, 0, 299, "");
    end

    if (
        (has_fake_perk(PERK_robosage) < 2) and
        (has_skill(dude_obj, SKILL_REPAIR) >= 50) and
        (get_critter_stat(dude_obj, STAT_iq) >= 6)
    ) then begin
        set_selectable_perk(PERK_robosage, 1, 300, mstr_perk(1249));
    end
    else begin
        set_selectable_perk(PERK_robosage, 0, 300, "");
    end

    if (
        (has_fake_perk(PERK_weapon_finesse_unarmed) < 2) and
        (has_skill(dude_obj, SKILL_UNARMED_COMBAT) >= 55) and
        not(has_trait(TRAIT_TRAIT, dude_obj, TRAIT_heavy_handed))
    ) then begin
        set_selectable_perk(PERK_weapon_finesse_unarmed, 1, 301, mstr_perk(1250));
    end
    else begin
        set_selectable_perk(PERK_weapon_finesse_unarmed, 0, 301, "");
    end

    if (
        (has_fake_perk(PERK_weapon_finesse_melee_weapons) < 2) and
        (has_skill(dude_obj, SKILL_MELEE) >= 55) and
        not(has_trait(TRAIT_TRAIT, dude_obj, TRAIT_heavy_handed))
    ) then begin
        set_selectable_perk(PERK_weapon_finesse_melee_weapons, 1, 302, mstr_perk(1251));
    end
    else begin
        set_selectable_perk(PERK_weapon_finesse_melee_weapons, 0, 302, "");
    end

    // apply perk effects, we call this on hook
    call perk_apply;

end

procedure perk_apply begin

    variable firewalker_levels;
    firewalker_levels := has_fake_perk(PERK_firewalker);

    if (firewalker_levels > 0) then begin
        variable old_fw_levels;
        old_fw_levels := get_sfall_global_int("fyp_fwbn");

        if (old_fw_levels != firewalker_levels) then begin
            set_pc_extra_stat(STAT_dmg_thresh_fire, (get_pc_extra_stat(STAT_dmg_thresh_fire) + (4 * firewalker_levels) - (4 * old_fw_levels)));
            // update levels
            set_sfall_global("fyp_fwbn", firewalker_levels);
        end
    end

    if (has_fake_perk(PERK_team_player)) then begin

        // apply for first time
        if ((get_sfall_global_int("fyp_tpbn") == 0) and (true_party_size >= 1)) then begin
            // bonus applied
            set_sfall_global("fyp_tpbn", 1);
            // remove reset
            set_sfall_global("fyp_tprm", 0);
            // apply 10% bonus to all skills
            call modify_all_skills(10);
        end
        // TODO: this should go in a global script maybe?
        // did we apply the bonus but player lost party members?
        else if ((get_sfall_global_int("fyp_tpbn") == 1) and (true_party_size == 0) and (get_sfall_global_int("fyp_tprm") == 0)) then begin
            // remove bonus applied
            set_sfall_global("fyp_tpbn", 0);
            // reset applied
            set_sfall_global("fyp_tprm", 1);
            // remove bonuses
            call modify_all_skills(-10);
        end
    end

    if (has_fake_perk(PERK_loner)) then begin

        // apply for first time
        if ((get_sfall_global_int("fyp_lobn") == 0) and (true_party_size == 0)) then begin
            // bonus applied
            set_sfall_global("fyp_lobn", 1);
            // remove reset
            set_sfall_global("fyp_lorm", 0);
            // apply 10% bonus to all skills
            call modify_all_skills(10);
        end
        // TODO: this should go in a global script maybe?
        // did we apply the bonus but player gained party members?
        else if ((get_sfall_global_int("fyp_lobn") == 1) and (true_party_size > 0) and (get_sfall_global_int("fyp_lorm") == 0)) then begin
            // remove bonus applied
            set_sfall_global("fyp_lobn", 0);
            // reset applied
            set_sfall_global("fyp_lorm", 1);
            // remove bonuses
            call modify_all_skills(-10);
        end
    end

    if (has_fake_perk(PERK_hide_of_scars) and get_sfall_global_int("fyp_hsbn") == 0) then begin
        set_pc_extra_stat(STAT_dmg_resist, (get_pc_extra_stat(STAT_dmg_resist) + 15));
        set_pc_extra_stat(STAT_dmg_resist_laser, (get_pc_extra_stat(STAT_dmg_resist_laser) + 15));
        set_pc_extra_stat(STAT_dmg_resist_plasma, (get_pc_extra_stat(STAT_dmg_resist_plasma) + 15));
        set_pc_extra_stat(STAT_dmg_resist_electrical, (get_pc_extra_stat(STAT_dmg_resist_electrical) + 15));
        set_pc_extra_stat(STAT_dmg_resist_emp, (get_pc_extra_stat(STAT_dmg_resist_emp) + 15));
        set_pc_extra_stat(STAT_dmg_resist_explosion, (get_pc_extra_stat(STAT_dmg_resist_explosion) + 15));
        set_sfall_global("fyp_hsbn", 1);
    end

    if (has_fake_perk(PERK_hit_the_deck) and get_sfall_global_int("fyp_hdbn") == 0) then begin
        set_pc_extra_stat(STAT_dmg_resist_explosion, (get_pc_extra_stat(STAT_dmg_resist_explosion) + 50));
        set_sfall_global("fyp_hdbn", 1);
    end

    if (has_fake_perk(PERK_tough_hide) and get_sfall_global_int("fyp_thbn") == 0) then begin
        set_pc_extra_stat(STAT_dmg_resist, (get_pc_extra_stat(STAT_dmg_resist) + 10));
        set_pc_extra_stat(STAT_dmg_resist_laser, (get_pc_extra_stat(STAT_dmg_resist_laser) + 10));
        set_pc_extra_stat(STAT_dmg_resist_plasma, (get_pc_extra_stat(STAT_dmg_resist_plasma) + 10));
        set_pc_extra_stat(STAT_dmg_resist_electrical, (get_pc_extra_stat(STAT_dmg_resist_electrical) + 10));
        set_pc_extra_stat(STAT_dmg_resist_emp, (get_pc_extra_stat(STAT_dmg_resist_emp) + 10));
        set_pc_extra_stat(STAT_dmg_resist_explosion, (get_pc_extra_stat(STAT_dmg_resist_explosion) + 10));
        set_pc_extra_stat(STAT_dmg_resist_fire, (get_pc_extra_stat(STAT_dmg_resist_fire) + 10));
        set_pc_extra_stat(STAT_ac, (get_pc_extra_stat(STAT_ac) + 15));
        set_sfall_global("fyp_thbn", 1);
    end

    // TODO
   if (has_fake_perk(PERK_esteemed_academic) and get_sfall_global_int("fyp_eabn") == 0) then begin
        set_global_var(GVAR_CRAFT_FLOATING_EYE_BOT, 1);
        set_sfall_global("fyp_eabn", 1);
    end

    if (has_fake_perk(PERK_advanced_research) and get_sfall_global_int("fyp_arbn") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_ENERGY_WEAPONS, 25);
        critter_mod_skill(dude_obj, SKILL_REPAIR, 25);
        set_sfall_global("fyp_arbn", 1);
    end

    if (has_fake_perk(PERK_divine_favor) and get_sfall_global_int("fyp_dfbn") == 0) then begin
        variable k, v, maxv, maxk;
        maxv := 0;
        maxk := -1;
        // The index order must match DEFINE.H
        variable all_stats = [
            get_critter_stat(dude_obj, STAT_st),
            get_critter_stat(dude_obj, STAT_pe),
            get_critter_stat(dude_obj, STAT_en),
            get_critter_stat(dude_obj, STAT_ch),
            get_critter_stat(dude_obj, STAT_iq),
            get_critter_stat(dude_obj, STAT_ag),
            get_critter_stat(dude_obj, STAT_lu)
            ];

        // Loop and find the highest value
        foreach (k: v in all_stats) begin
            if (maxv == 0 or v > maxv) then begin
                maxv := v;
                maxk := k;
            end
        end

        if (maxk != -1) then begin
            call set_dude_attr(maxk, get_pc_base_stat(maxk) + 1);
            set_sfall_global("fyp_dfbn", 1);
        end
    end

    if (has_fake_perk(PERK_stunt_man) and get_sfall_global_int("fyp_smbn") == 0) then begin
        set_pc_extra_stat(STAT_dmg_resist_explosion, (get_pc_extra_stat(STAT_dmg_resist_explosion) + 25));
        critter_mod_skill(dude_obj, SKILL_OUTDOORSMAN, 10);
        set_sfall_global("fyp_smbn", 1);
    end

    if (has_fake_perk(PERK_cancerous_growth) and get_sfall_global_int("fyp_cgbn") == 0) then begin
        set_pc_extra_stat(STAT_heal_rate, (get_pc_extra_stat(STAT_heal_rate) + 2));
        set_sfall_global("fyp_cgbn", 1);
    end

    if (has_fake_perk(PERK_deadly_accuracy_small_guns) and get_sfall_global_int("fyp_dasg") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_SMALL_GUNS, 20);
        set_sfall_global("fyp_dasg", 1);
    end

    if (has_fake_perk(PERK_deadly_accuracy_big_guns) and get_sfall_global_int("fyp_dabg") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_BIG_GUNS, 20);
        set_sfall_global("fyp_dabg", 1);
    end

    if (has_fake_perk(PERK_deadly_accuracy_energy_weapons) and get_sfall_global_int("fyp_daew") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_ENERGY_WEAPONS, 20);
        set_sfall_global("fyp_daew", 1);
    end

    if (has_fake_perk(PERK_deadly_accuracy_throwing) and get_sfall_global_int("fyp_dath") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_THROWING, 20);
        set_sfall_global("fyp_dath", 1);
    end

    if (has_fake_perk(PERK_pugilist) and get_sfall_global_int("fyp_pugi") == 0) then begin
        set_pc_extra_stat(STAT_melee_dmg, get_pc_extra_stat(STAT_melee_dmg) + 2);
        set_sfall_global("fyp_pugi", 1);
    end

    if (has_fake_perk(PERK_observant) and get_sfall_global_int("fyp_obsr") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_TRAPS, 25);
        critter_mod_skill(dude_obj, SKILL_LOCKPICK, 5);
        set_sfall_global("fyp_obsr", 1);
    end

    if (has_fake_perk(PERK_superior_senses) and get_sfall_global_int("fyp_sups") == 0) then begin
        critter_mod_skill(dude_obj, SKILL_TRAPS, 15);
        call set_dude_attr(STAT_pe, get_pc_base_stat(STAT_pe) + 1);
        set_sfall_global("fyp_sups", 1);
    end

    variable weapon_finesse_unarmed_levels;
    weapon_finesse_unarmed_levels := has_fake_perk(PERK_weapon_finesse_unarmed);

    if (weapon_finesse_unarmed_levels > 0) then begin
        variable old_wfu_levels;
        old_wfu_levels := get_sfall_global_int("fyp_wfun");

        if (old_wfu_levels != weapon_finesse_unarmed_levels) then begin
            critter_mod_skill(dude_obj, SKILL_UNARMED_COMBAT, (10 * weapon_finesse_unarmed_levels) - (10 * old_wfu_levels));
            // update levels
            set_sfall_global("fyp_wfun", weapon_finesse_unarmed_levels);
        end
    end

    variable weapon_finesse_melee_levels;
    weapon_finesse_melee_levels := has_fake_perk(PERK_weapon_finesse_melee_weapons);

    if (weapon_finesse_melee_levels > 0) then begin
        variable old_wfmw_levels;
        old_wfmw_levels := get_sfall_global_int("fyp_wfmw");

        if (old_wfmw_levels != weapon_finesse_melee_levels) then begin
            critter_mod_skill(dude_obj, SKILL_MELEE, (10 * weapon_finesse_melee_levels) - (10 * old_wfmw_levels));
            // update levels
            set_sfall_global("fyp_wfmw", weapon_finesse_melee_levels);
        end
    end
end

procedure start begin
    variable mode;
    mode := get_sfall_global_int("fy_prk02");

    if((mode != dude_level) and (dude_level > 1)) then begin
        register_hook_proc(HOOK_GAMEMODECHANGE, perk_level_change);
        call perk_level_change;
        set_sfall_global("fy_prk02", dude_level);
    end
end

procedure modify_all_skills(variable mod) begin
    variable skill = SKILL_SMALL_GUNS;

    // Loop through all 18 skills
    while (skill <= SKILL_OUTDOORSMAN) do begin
        critter_mod_skill(dude_obj, skill, mod);
        skill ++;
    end
end
