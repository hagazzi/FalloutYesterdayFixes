procedure start begin
end

procedure map_enter_p_proc begin
   call Check_Create_Vehicle;

   fadein(1);
   Lighting;

   ambient_sfx := play_sfall_sound(AmbientTrack(AMBIENT_WIND_IN_THE_GRASS), 1);
end

procedure map_update_p_proc begin

   Lighting;

end

procedure map_exit_p_proc begin
   fadeout(1);
end
