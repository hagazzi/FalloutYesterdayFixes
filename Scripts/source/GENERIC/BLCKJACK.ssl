      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if ((DealerHand > 21) and (DealerAceValueCheckFlag > 0)) then begin
      DealerHand := DealerHand - 10;
      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if ((DealerHand > 21) and (DealerAceValueCheckFlag > 0)) then begin
      DealerHand := DealerHand - 10;
      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if ((DealerHand > 21) and (DealerAceValueCheckFlag > 0)) then begin
      DealerHand := DealerHand - 10;
      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if ((DealerHand > 21) and (DealerAceValueCheckFlag > 0)) then begin
      DealerHand := DealerHand - 10;
      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if ((DealerHand > 21) and (DealerAceValueCheckFlag > 0)) then begin
      DealerHand := DealerHand - 10;
      DealerAceValueCheckFlag := DealerAceValueCheckFlag - 1;
   end
   Temp := 0;
   if (DealerHand < 16) then begin
      call Draw_To_16();
   end
end

