      displayGfx(PlayerHandSlot7, (15 * 7) + 0, 200, 71, 96);
   end
   if (PlayerHandSlot8 != 0) then begin
      displayGfx(PlayerHandSlot8, (15 * 8) + 0, 200, 71, 96);
   end
   Card = RandomCard();
   displayGfx(Card, (15 * PlayerHandCardCounter) + 0, 200, 71, 96);
   if (PlayerHandSlot2 == 0) then begin
      PlayerHandSlot2 := Card;
   end
   else begin
      if (PlayerHandSlot3 == 0) then begin
         PlayerHandSlot3 := Card;
      end
      else begin
         if (PlayerHandSlot4 == 0) then begin
            PlayerHandSlot4 := Card;
         end
         else begin
            if (PlayerHandSlot5 == 0) then begin
               PlayerHandSlot5 := Card;
            end
