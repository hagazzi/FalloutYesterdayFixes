procedure use_p_proc begin
   create_win_flag("BlackjackWin", (get_screen_width - 640) / 2, (get_screen_height - 480) / 2, 640, 480, WIN_FLAG_EXCLUSIVE);
   selectWin("BlackjackWin");
   display("pcx/blackjack/TABLE.PCX");
   displayGfx("pcx/blackjack/DUMMY.PCX", 0, 0, 48, 36);
   displayGfx("pcx/blackjack/DUMMY.PCX", 48, 0, 48, 36);
   displayGfx("pcx/blackjack/DUMMY.PCX", 96, 0, 48, 36);
   displayGfx("pcx/blackjack/DUMMY.PCX", 144, 0, 48, 36);
   addButton("DealBtn", 0, 0, 48, 36);
   addButtonGfx("DealBtn", "pcx/blackjack/DEAL.PCX", "pcx/blackjack/DEAL.PCX", "pcx/blackjack/DEAL.PCX");
   addButtonProc("DealBtn", Do_Nothing, Do_Nothing, Do_Nothing, Deal);
   addButton("QuitBtn", 144, 0, 48, 36);
   addButtonGfx("QuitBtn", "pcx/blackjack/QUIT.PCX", "pcx/blackjack/QUIT.PCX", "pcx/blackjack/QUIT.PCX");
   addButtonProc("QuitBtn", Do_Nothing, Do_Nothing, Do_Nothing, Quit);
   showWin;
   mouseShape("pcx/blackjack/CUR.PCX", 0, 0);
end

