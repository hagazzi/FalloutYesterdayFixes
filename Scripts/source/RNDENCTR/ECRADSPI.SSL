/*
        Name: Generic Lesser Rat
        Location: Arroyo
        Description: Generic lesser rat when you need a small, not very strong rat.

        Log:

           Created: December 02, 1997

           Updated:
*/

/* Include Files */

#include "..\headers\define.h"
//#include "..\headers\<TownName.h>"

#define NAME                    SCRIPT_ECRADSPI

#include "..\headers\command.h"
//#include "..\headers\ModReact.h"
#include "..\headers\party.h"

/* Standard Script Procedures */
procedure start;
procedure critter_p_proc;
procedure destroy_p_proc;
procedure look_at_p_proc;
procedure description_p_proc;
procedure use_skill_on_p_proc;
procedure damage_p_proc;
procedure map_enter_p_proc;
procedure timed_event_p_proc;
procedure combat_p_proc;
procedure map_exit_p_proc;

/* Local variables which do not need to be saved between map changes. */
variable pissed:=false;

procedure start begin
end

procedure timed_event_p_proc begin
   if ((pissed == false) and ((critter_state(self_obj) bwand DAM_KNOCKED_OUT) == FALSE)) then begin
      reg_anim_clear(self_obj);
      reg_anim_begin();
         animate_move_to_tile(tile_num_in_direction(tile_num(self_obj),random(0,5),random(3,9)));
      reg_anim_end();
   end
   add_timer_event(self_obj,game_ticks(random(3,5)),0);
end

procedure combat_p_proc begin
   if (fixed_param == COMBAT_SUBTYPE_HIT_SUCCEEDED) then begin

         variable poison_amt;
         if (self_fid == FID_MASPDS) then begin
            poison_amt = random(1,3);
         end else begin
            poison_amt = random(3,9);
         end

         poison(target_obj,poison_amt);

       if ((target_obj == dude_obj) and not(dude_immune_to_radiation)) then begin

         variable rad_amt;
         if (self_fid == FID_MASPDS) then begin
            rad_amt = random(1,5);
         end else begin
            rad_amt = random(4,20);
         end

            radiation_inc(target_obj,rad_amt);
       end
   end
end

procedure critter_p_proc begin
   // the rat attacks if it sees the player
   if (self_can_see_dude) then begin
         pissed := true;
         self_attack_dude;
   end
end

procedure destroy_p_proc begin
   inc_neutral_critter
end

procedure damage_p_proc begin
   if (pissed == false) then begin
      pissed := true;
         self_attack_dude;

   end
end

procedure look_at_p_proc begin
end

procedure description_p_proc begin
   call BeastlordPossess;
end

procedure use_obj_on_p_proc begin
end

procedure use_skill_on_p_proc begin
   if (action_being_used == SKILL_STEAL) then begin
      script_overrides;
   end

   call injure_with_skill;
end

procedure map_enter_p_proc begin
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_TEAM_NUM,TEAM_RND_RADSPIDER);
   critter_add_trait(self_obj,TRAIT_OBJECT,OBJECT_AI_PACKET,AI_GENERIC_SCORPION);
   add_timer_event(self_obj,game_ticks(random(1,5)),0);
end

procedure map_exit_p_proc begin
   call BeastlordUnpossess(TEAM_RND_RADSPIDER);
end
