#include "..\headers\define.h"

import variable scouted_crypts;

procedure start;


procedure start begin
   if (script_action == spatial_proc) then begin
      if (scouted_crypts == 1) then begin
         scouted_crypts := 2;
         set_global_var(GVAR_CSCOUT_1, 2);
         display_msg(message_str(SCRIPT_SCRPHEAP, 404));
      end
   end
end
