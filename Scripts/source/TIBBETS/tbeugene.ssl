// Node Start
//
// Notes:
//
// Option 1 should not appear if PC's PE is less than 6

procedure StartD
begin
Reply(200);
if (get_critter_stat(dude_obj,STAT_pe)>=6) then
NOption(201,AA,4);
// NOTE: if the player fails this check, it should lead to node B_Fail
if (has_skill(dude_obj,SKILL_CONVERSANT)>=75) then
NOption(202,Skill_Check_001_Speech,4);
NOption(203,II,4);
if (obj_is_carrying_obj_pid(dude_obj,PID_PASSWORD_PAPER_EUGENE)>0) then
NOption(204,ZZ,4);
if (get_critter_stat(dude_obj,STAT_pe)>=6) then
NOption(205,Node017,4);
NOption(206,Node999,4);
NOption(207,Node016,-3);
end

procedure AA
begin
Reply(230);
NOption(231,JJ,4);
NOption(232,Node999,4);
end

procedure B_Pass
begin
Reply(260);
NOption(261,GG,4);
NOption(262,HH,4);
end

procedure II
begin
if (dude_is_male) then Reply(290); else
if (dude_is_female) then Reply(291);
// NOTE: This should remove 3000 caps from the players inverntory.
if (item_caps_total(dude_obj)>=3000) then
NOption(292,ZZ_3000,4);
// NOTE: Failure on the check should lead to M
if (has_skill(dude_obj,SKILL_BARTER)>=65) then
NOption(293,Skill_Check_000_Barter,4);
NOption(294,Node999,4);
end

// Node JJ
//
// Notes:
//
// At this point, the sentry should start counting down from 10, one number per response.

