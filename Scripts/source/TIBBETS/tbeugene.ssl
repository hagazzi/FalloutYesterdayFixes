procedure ZZ_3000 begin
   item_caps_adjust(dude_obj, -3000);
   item_caps_adjust(self_obj, 3000);
   call ZZ;

end

procedure OpenDoor begin
   variable door;

   fadeout(1);

   door := tile_contains_pid_obj(12887, 0, 33554628);

   obj_unlock(door);                                    // engine unlock door
   obj_open(door);

   fadein(1);

end

