procedure Leave begin
   call Node999;
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   give_xp(350);
   display_mstr(150);
   inc_global_var_amt(GVAR_TOWN_REP_TIBBETS, 20);
   inc_general_rep(10);
   set_map_var(MVAR_MAURICE_GONE, 1);
   fadein(1);
end

