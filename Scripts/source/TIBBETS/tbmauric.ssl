// Node Threat
//
// Notes:
//
// 1) go here if moderate intimidate check passed - 2) if check failed

procedure Threat
begin
Reply(1130);
if (get_critter_stat(dude_obj,STAT_ch)>=6) then
NOption(1131,Intimidated,4);
if (get_critter_stat(dude_obj,STAT_ch)<=5) then
NOption(1131,NotIntimidated,4);
BOption(1132,Node998,4);
end

