// Node Fergie_sex_screwed2
//
// Notes:
//
// The PC and Fergie are teleported to to Fergie's home. Any followers that the PC has are to be left at the bar. They will automatically rejoin the PC when she returns to the CrossHou map, provided the PC has room for all of them. If not, then they will all stay at the bar and the PC will have to manually select the followers she wants.

procedure Fergie_sex_screwed2
begin
Reply(1130);
NOption(1131,Fergie_been_screwed,4);
end

procedure Fergie_been_screwed
begin

fadeout(1);
do_default_sex;
game_time_advance( random(6,8) * ONE_GAME_HOUR);
fadein(1);

Reply(1160);
GOption(1161,Screwed_good,4);
NOption(1162,Screwed_ok,4);
BOption(1163,Screwed_bad,4);
end

