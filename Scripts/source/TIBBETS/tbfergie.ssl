procedure Fergie_1
begin
if (dude_is_male) then Reply(231); else
if (dude_is_female) then Reply(230);
NOption(232,Fergie_info,4);
NOption(233,Fergie_drink,4);
NOption(234,Node999,4);
end

procedure Fergie_2
begin
if (dude_is_male) then Reply(261); else
if (dude_is_female) then Reply(260);
NOption(262,Fergie_info_return,4);
NOption(263,Fergie_drink,4);
if (dude_is_male and get_dude_attr(STAT_ch) >= 7 and local_var(LVAR_Sex) == 1) then
NOption(264,Fergie_sex_smart_sex,4);
end

procedure Fergie_3
begin

if(local_var(LVAR_Blackmail) > 0) then begin

   if(local_var(LVAR_Blackmail) == 1) then begin
      variable r;
      r := random(1,4);
      if(r == 1) then begin
         give_pid_qty(dude_obj, PID_RADSCORPION_PARTS, 1)
      end else if(r > 1) then begin
         give_pid_qty(dude_obj, PID_PUMP_PARTS, 1)
      end
   end
   else if(local_var(LVAR_Blackmail) == 10) then begin
      item_caps_adjust(dude_obj, 10);
   end else if(local_var(LVAR_Blackmail) == 50) then begin
      item_caps_adjust(dude_obj, 50);
end else if(local_var(LVAR_Blackmail) == 100) then begin
      item_caps_adjust(dude_obj, 100);
end

   add_timer_event(self_obj,ONE_GAME_DAY,local_var(LVAR_Blackmail));
   set_local_var(LVAR_Blackmail, 0);

end

Reply(290);
NOption(291,Fergie_ignore_menu,4);
NOption(292,Fergie_ignore,4);
NOption(293,Node999,4);
end

