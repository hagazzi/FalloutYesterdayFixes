procedure Screwed_Blackmail_caps
begin
Reply(1310);
NOption(1311,Blackmail_caps_10,4);
// NOTE: This option only visible if the PC has a barter skill of 75% or higher.
if (has_skill(dude_obj,SKILL_BARTER)>=75) then
NOption(1312,Blackmail_caps_50_success,4);
// NOTE: This option only visible if the PC has a barter skill of 74% or lower.
if (has_skill(dude_obj,SKILL_BARTER)<=74) then
NOption(1312,Blackmail_caps_50_fail,4);
// NOTE: This option only visible if the PC has a barter skill of 140% or higher.
if (has_skill(dude_obj,SKILL_BARTER)>=140) then
NOption(1313,Blackmail_caps_100_success,4);
// NOTE: This option only visible if the PC has a barter skill of139% or lower.
if (has_skill(dude_obj,SKILL_BARTER)<=139) then
NOption(1313,Blackmail_caps_100_fail,4);
end

