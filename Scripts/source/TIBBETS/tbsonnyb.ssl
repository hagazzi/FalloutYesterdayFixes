// Node Noquest
//
// Notes:
//
// 1) available if greatest haul not triggered \

procedure Noquest
begin
Reply(230);
if(global_var(GVAR_QUEST_GREATEST_HAUL) == 0) then
NOption(231,WhoIs,4);
if(global_var(GVAR_SONNY_BLACK_SHERIFF) == 1) and (global_var(GVAR_SONNY_RED_SHERIFF) == 0) and (global_var(GVAR_SHERIFF_SHARE_SPOT) == 0) then
NOption(232,InChargeHonest,4);
if(global_var(GVAR_SONNY_BLACK_SHERIFF) == 0) and (global_var(GVAR_SONNY_RED_SHERIFF) == 1) and (global_var(GVAR_SHERIFF_SHARE_SPOT) == 0) then
NOption(232,SonnyRedInCharge,4);
if(global_var(GVAR_SHERIFF_SHARE_SPOT) == 1) then
NOption(232,JointCharge,4);
NOption(233,Node999,4);
NOption(234,Stupid,-3);
NOption(235,Stupid4,-3);
NOption(236,Node999,-3);
end

// Node Preparing
//
// Notes:
//
// 1) if salesman of the year is active. 2) if sabotage Sonny Black is active 3) if murder Sonny Black is active 4) if Sonny Red has agreed to share

procedure Preparing
begin
Reply(260);
if(global_var(GVAR_QUEST_SALESMAN) == 1) then
NOption(261,SonnyRedSales,4);
if(global_var(GVAR_QUEST_SABOTAGE_SONNYB) == 1) then
NOption(262,SonnyRedSabotage,4);
if(global_var(GVAR_QUEST_MURDER_SONNYB) == 1) then
NOption(263,SonnyRedMurderPlot,4);
if(global_var(GVAR_SONNYB_SHARE) == 1) then
NOption(264,WantsShare,4);
NOption(265,AskSharePrep,4);
NOption(266,Node999,4);
end

// Node WantNews
//
// Notes:
//
// 1) if Joe gives company/no actions by player 2) if Joe gives company - Sonny Black's brought in haul 3) if Joe agrees to sharing 4) if Joe died due to ultimatum 5) if Sonny Red's persuaded to share/no actions by player 6) if Sonny Red agrees as murder plots revealed 7) if Sonny Red agrees as both proved selves 8) if both murder plots triggered 9)if Joe not persuaded/no actions taken 10) if Joe not persuaded/Sonny Black has brought haul 11) if sabotage Sonny Black is active 12) if kill Sonny Black is active 13) if sabotage committed 14) if Sonny Red killed

procedure WantNews
begin
Reply(290);
if(global_var(GVAR_SONNY_BLACK_SHERIFF) == 1) then
NOption(291,TalkedPeteRound,4);
if(global_var(GVAR_SONNY_BLACK_SHERIFF) == 1) and (global_var(GVAR_QUEST_GREATEST_HAUL) == 2) then
NOption(291,TalkedPeteRound2,4);
if(global_var(GVAR_SHERIFF_SHARE_SPOT) == 1) then
NOption(292,TalkedShare,4);
if(global_var(GVAR_CARMICHAEL_DEAD) == 1) then
NOption(293,Ultimatum,4);
if(global_var(GVAR_SONNYR_SHARE_SPOT) == 1) then
NOption(294,WantsShare,4);
if(global_var(GVAR_SONNYR_SHARE_SPOT) == 1) and (global_var(GVAR_QUEST_MURDER_SONNYB) == 1) and (local_var(LVAR_Know_Murder_Plot) == 1) then
NOption(295,ShareEasy,4);
if(global_var(GVAR_SONNYR_SHARE_SPOT) == 1) and (global_var(GVAR_QUEST_GREATEST_HAUL) == 2) and (global_var(GVAR_QUEST_SALESMAN) == 2) then
NOption(296,ShareEasy,4);
if(global_var(GVAR_SONNYR_SHARE_SPOT) == 1) and (global_var(GVAR_QUEST_MURDER_SONNYB) == 1) and (global_var(GVAR_QUEST_MURDER_SONNYR) == 1) then
NOption(297,RealiseTooFar,4);
if(global_var(GVAR_SHERIFF_SHARE_SPOT) == 0)  and (global_var(GVAR_QUEST_GREATEST_HAUL) == 0) then
NOption(298,NoPersuade,4);
if(global_var(GVAR_SHERIFF_SHARE_SPOT) == 0) and (global_var(GVAR_QUEST_GREATEST_HAUL) == 2) then
NOption(299,NoPersuade2,4);
if(global_var(GVAR_QUEST_SABOTAGE_SONNYB) == 1) then
NOption(262,SonnyRedSabotage,4);
if(global_var(GVAR_QUEST_MURDER_SONNYB) == 1) then
NOption(263,SonnyRedMurderPlot,4);
if(global_var(GVAR_QUEST_SABOTAGE_SONNYR) == 2) then
NOption(300,SabotagedSonnyRed,4);
if(global_var(GVAR_SONNY_RED_DEAD) == 1) then
NOption(301,KilledSonnyRed,4);
NOption(302,Node999,4);
end

