// Node BeenBeaten
//
// Notes:
//
// If PC has never met/spoken with NPC goto Intro01\

procedure BeenBeaten
begin
if (dude_is_male) then Reply(800); else
if (dude_is_female) then Reply(561);
// NOTE: This option must NOT be offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) < 8 OR has_skill(dude_obj, SKILL_MELEE) < 130) then begin
if (dude_is_male) then
BOption(801,NewTricks,4);
end
// NOTE: This option must NOT be offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) < 7 OR has_skill(dude_obj, SKILL_MELEE) < 120) then begin
if (dude_is_female) then
BOption(802,NewTricks,4);
end
// NOTE: This option is ONLY offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) >= 8 OR has_skill(dude_obj, SKILL_MELEE) >= 130) then begin
if (dude_is_male) then
BOption(803,IntimidationFinal00,4);
end
// NOTE: This option is ONLY offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) >= 8 OR has_skill(dude_obj, SKILL_MELEE) >= 130) then begin
if (dude_is_male) then
NOption(804,IntimidationFinal00,-3);
end
// NOTE: This option is ONLY offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) >= 7 OR has_skill(dude_obj, SKILL_MELEE) >= 120) then begin
if (dude_is_female) then
BOption(805,IntimidationFinal00,4);
end
// NOTE: This option is ONLY offered if the PC meets the successful intimidation conditions
if(get_critter_stat(dude_obj, STAT_st) >= 7 OR has_skill(dude_obj, SKILL_MELEE) >= 120) then begin
if (dude_is_female) then
BOption(806,IntimidationFinal00,-3);
end
end

procedure IntimidationFinal00
begin
if (dude_is_male) then Reply(830); else
if (dude_is_female) then Reply(831);
if (dude_is_male) then
BOption(832,IntimidationFinal01,4);
if (dude_is_female) then
BOption(833,IntimidationFinal01,4);
NOption(951,Node999,1);
end

procedure IntimidationFinal01
begin
if (dude_is_male) then begin
   dec_general_rep(1);
   dec_tibbets_rep(-1);
   Reply(860);
end else if (dude_is_female) then begin
   Reply(861);
end
// NOTE: Fade out? The NPC is now gone for good.
if (dude_is_male) then
BOption(862,LeaveForever,4);
// NOTE: Fade out? The NPC is now gone for good.
if (dude_is_male) then
BOption(863,LeaveForever,-3);
if (dude_is_female) then
BOption(864,IntimidationFinal02,4);
NOption(951,Node999,1);
end

procedure IntimidationFinal02
begin
Reply(891);
BOption(892,IntimidationFinal03,4);
NOption(951,Node999,1);
end

procedure IntimidationFinal03
begin
Reply(950);
NOption(711,Node999,4);
end

procedure LeaveBeaten begin
   call Node999;
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   set_local_var(LVAR_Been_Threatened, 1);
   fadein(1);
end

procedure LeaveFight begin
   call Node998;
   set_local_var(LVAR_Been_Threatened, 1);
end

procedure LeaveForever begin
   call LeaveBeaten;
   set_local_var(LVAR_Been_Threatened, 2);
   give_xp(200);
   inc_tibbets_rep(10);
   display_mstr(150);
end


