#include "..\headers\define.h"
#include "..\headers\command.h"

#define NAME                    SCRIPT_DEMODOOR

procedure start;
procedure do_stuff;
procedure do_use_stuff;
procedure do_skill;
procedure examine;

variable unlocked;
variable open;
variable test;
variable fridge_xp_once;

import variable Use_Fridge;


procedure start begin
   if (script_action == description_proc) then begin
      script_overrides;
      call examine();
   end
   else begin
      if (script_action == look_at_proc) then begin
         script_overrides;
         display_mstr(108);
      end
      else begin
         if (script_action == use_proc) then begin
            call do_use_stuff();
         end
         else begin
            if (script_action == pickup_proc) then begin
               call do_stuff();
            end
            else begin
               if (script_action == use_skill_on_proc) then begin
                  if (action_being_used == SKILL_LOCKPICK) then begin
                     script_overrides;
                     call do_skill();
                  end
                  else begin
                     display_mstr(106);
                  end
               end
               else begin
                  if (script_action == timed_event_proc) then begin
                     Use_Fridge := 0;
                  end
               end
            end
         end
      end
   end
end

procedure do_stuff begin
   Use_Fridge := 1;
   if (unlocked == 0) then begin
      script_overrides;
   end
   add_timer_event(self_obj, 5, 1);
end

procedure do_use_stuff begin
   if (unlocked != 0) then begin
      if (open) then begin
         open := 0;
      end
      else begin
         Use_Fridge := Use_Fridge + 1;
         open := 1;
      end
   end
   else begin
      script_overrides;
      display_mstr(105);
   end
end

procedure do_skill begin
   Use_Fridge := Use_Fridge + 1;
   if (unlocked == 0) then begin
      test := roll_vs_skill(dude_obj, SKILL_LOCKPICK, 0);
      if (is_success(test)) then begin
         if(not(fridge_xp_once)) then begin
            give_xp(25);
            fridge_xp_once = 1;
         end
         display_mstr(100);
         unlocked := 1;
      end
      else begin
         display_mstr(101);
      end
   end
   else begin
      display_mstr(107);
   end
end

procedure examine begin
   if (not(unlocked)) then begin
      display_mstr(102);
   end
   else begin
      if (open) then begin
         display_mstr(103);
      end
      else begin
         display_mstr(104);
      end
   end
end
