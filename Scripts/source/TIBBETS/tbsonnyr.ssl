// Node FirstMeeting
//
// Notes:
//
// 3) if 'greatest haul ever' triggered

procedure FirstMeeting
begin
if (dude_is_male) then Reply(230); else
if (dude_is_female) then Reply(231);
NOption(232,SellFish,4);
NOption(233,GoodMood,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) > 0) then
NOption(234,GreatestHaul,4);
NOption(235,HardSell,4);
NOption(236,Stupid,-3);
NOption(237,Stu_hardsell,-3);
end

// Node BackAgain
//
// Notes:
//
// 3) available if 'greatest haul ever' is triggered 4) if has been told about greatest haul but doesnt take it seriously\

procedure BackAgain
begin
Reply(260);
NOption(261,SellFish,4);
NOption(233,GoodMood,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) > 0) then
NOption(262,GreatestHaul,4);
if(local_var(LVAR_Know_Greatest_Haul) == 1) then
NOption(263,StartGreatHaul,4);
NOption(264,Node999,4);
NOption(265,Stupid,-3);
NOption(266,Stu_MoreMag,-3);
NOption(267,Stu_Return,-3);
NOption(268,Stu_hardsell,-3);
end

// Node WantNews
//
// Notes:
//
// 2)if both murder plots triggered 3)if Sonny Black's haul was successful, Sonny Red was not sabotaged 4)if Sonny Black's haul was successful, Sonny Red wants to beat him up 5) if Sonny Black's haul was unsuccessful, Sonny Red was not sabotaged 6)if Sonny Black's haul was unsuccessful, Sonny Red wants to beat him up 7)if player has sabotaged Sonny Black 8)if player has planted dynamite 9)if player has been asked to sabotage Sonny Red 10)if player has been asked to kill Sonny Red

procedure WantNews
begin
Reply(290);
NOption(291,ShareSuggest,4);
if(global_var(GVAR_QUEST_MURDER_SONNYB) == 1) and (global_var(GVAR_QUEST_MURDER_SONNYR) == 1) then
NOption(292,TooFar,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) == 2) and (global_var(GVAR_QUEST_SABOTAGE_SONNYR) < 2) then
NOption(293,SonnyBlacksBackSuccessful,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) == 2) and (local_var(LVAR_BeatUp) == 1) then
NOption(293,SonnyBlacksBackBeatup,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) == 3) and (global_var(GVAR_QUEST_SABOTAGE_SONNYR) < 2) then
NOption(294,SonnyBlacksBackUnsuccessful,4);
if(global_var(GVAR_QUEST_GREATEST_HAUL) == 3) and (local_var(LVAR_BeatUp) == 1) then
NOption(294,SonnyBlacksBackBeatup,4);
if(global_var(GVAR_QUEST_SABOTAGE_SONNYB) == 2) then
NOption(295,SabotagedSonnyBlack,4);
if(global_var(GVAR_SONNY_BLACK_DEAD) == 1) then
NOption(296,KilledSonnyBlack,4);
if(global_var(GVAR_QUEST_SABOTAGE_SONNYR) == 1) then
NOption(297,SonnyBlackSabotage,4);
if(global_var(GVAR_QUEST_MURDER_SONNYR) == 1) then
NOption(298,SonnyBlackKill,4);
NOption(299,Node999,4);
end

