procedure Node999_kill_both begin
   fadeout(1);
   set_obj_visibility(self_obj, 1);
   fadein(1);
   set_global_var(GVAR_SONNY_BLACK_DEAD, 1);
   set_global_var(GVAR_SONNY_RED_DEAD, 1);
   call Node999;
end


