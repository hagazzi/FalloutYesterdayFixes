procedure Nora_unmet
begin
Reply(230);
BOption(231,Nora_impatient,4);
if (has_skill(dude_obj,SKILL_CONVERSANT)>=50) then
BOption(232,Nora_impatient,4);
if(global_var(GVAR_ASYLUM_WORK) == 1) then
NOption(mstr(233)+dude_name+mstr(234),Nora_job,4);
if(not(nest_destroyed)) then
NOption(235,Nora_radscorpions,4);
BOption(236,Nora_stupid,-3);
BOption(237,Node998,4);
NOption(238,Node999,4);
end

